---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
// Site-wide typeface, self-hosted. Loaded once here so every page that uses
// Layout inherits it. Do not add font-family declarations anywhere else.
import '@fontsource-variable/inter';
interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
  datePublished?: string;  // ISO for articles
  dateModified?: string;   // ISO for articles
  authorName?: string;     // for articles
	publisherName?: string;  // for articles
	noindex?: boolean;
	robots?: string;         // explicit robots override, e.g. "noindex,follow"
}

const siteUrl = "https://davidjforer.com";
const siteName = "David J Forer | AI Operations Consultant";
const defaultImage = "/images/ai-automation.webp";
const twitterHandle = "@davidjforer"; // remove tag below if not used

const { 
	title, 
	description = "AI Operations with David Forer",
	image = "/images/ai-automation.webp",
	authorName = 'David J Forer',
  publisherName = 'David J Forer',
	noindex = false,
	robots: robotsOverride,
} = Astro.props;

const origin = 'https://davidjforer.com';
const canonical = new URL(Astro.url.pathname, origin).href;
// keep using your existing {title} and {description} props
const robots = robotsOverride ?? (noindex ? 'noindex,nofollow' : 'index,follow');
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Analytics, loaded after the LCP window rather than in the head.
		     gtag.js is 173KB and TruConversion pulls more behind it. Loading both
		     eagerly cost 2.1 seconds of mobile LCP: 4.1s with them, 2.0s without,
		     measured on the live page. They are 176KB of a 258KB page.

		     The gtag stub and dataLayer queue stay here, so any gtag() call made
		     before the real script arrives is buffered and sent once it loads.
		     A visitor who stays past the trigger is counted normally. A visitor
		     who leaves before it fires is not counted at all, which is the
		     deliberate trade. Trigger is first interaction, or 3s idle. -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			window._tip = window._tip || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-8TFRGRQPZ1');

			(function () {
				var loaded = false;
				var triggers = ['scroll', 'pointerdown', 'keydown', 'touchstart'];

				function add(src, id) {
					var s = document.createElement('script');
					s.async = true;
					if (id) s.id = id;
					s.src = src;
					document.head.appendChild(s);
				}

				function load() {
					if (loaded) return;
					loaded = true;
					triggers.forEach(function (t) { window.removeEventListener(t, load); });
					add('https://www.googletagmanager.com/gtag/js?id=G-8TFRGRQPZ1');
					if (!document.getElementById('ti-js')) {
						add('https://app.truconversion.com/ti-js/37589/7faf4.js', 'ti-js');
					}
				}

				// Real interaction loads immediately, because that is intent.
				triggers.forEach(function (t) {
					window.addEventListener(t, load, { passive: true, once: true });
				});

				// The automatic path waits for load first. Arming requestIdleCallback
				// straight away would let it fire before the largest paint on a fast
				// connection, which is the exact thing this is meant to prevent.
				function arm() {
					if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2000 });
					else setTimeout(load, 2000);
				}

				if (document.readyState === 'complete') arm();
				else window.addEventListener('load', arm, { once: true });
			})();
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- No favicon.svg line here. There is no favicon.svg in public/, so it
		     404ed on every page of the site and logged a console error. The .ico
		     and the two PNGs below cover every browser. -->
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="canonical" href={canonical} />
		<meta name="robots" content={robots} />
		<meta name="author" content={authorName} />
		<meta name="publisher" content={publisherName} />

	
		<!-- Preconnect to critical 3rd-party origins -->
		<link rel="preconnect" href="https://bricks.davidjforer.com" crossorigin />

		<!-- No Calendly here.
		     It used to load site-wide, on every page, for the benefit of exactly
		     one button: the popup CTA in Hero.astro. Every other booking link on
		     the site is a plain anchor to calendly.com and needs no script at
		     all. The only other real widget is the inline embed on /contact,
		     which loads its own copy on that page.
		     Hero.astro now loads it on hover or click. That also removed the last
		     third-party cookie (__cf_bm, set by Cloudflare on assets.calendly.com)
		     from every page that does not need Calendly. -->

		<!-- TruConversion is loaded by the gated analytics loader above, together
		     with gtag. Do not add an eager script tag for it here again. -->

<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
                        
	</head>
	<body>
		<Navigation />
		<main>
			<div class="content-wrapper">
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>
<style is:global>
	@import '../styles/global.css';
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
	html, body {
		/* font-family intentionally omitted: it comes from Tailwind
		   theme.fontFamily.sans via preflight. See tailwind.config.js. */
		background: #ffffff;
		background-size: cover;
		background-repeat: no-repeat;
		background-attachment: fixed;
		min-height: 100vh; /* Ensures full viewport height coverage */
	}

	/* Add styling for the content wrapper */
	.content-wrapper {
		/*max-width: 1800px;*/ /* Set the maximum width */
		margin: 0; /* Center the content */
		padding: 0; /* Optional: add padding for mobile spacing */
		width: 100%;
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
	main {
		margin: 0;
		padding: 0;
		width: 100%; 
		/*max-width: 1800px !important;*/
	}	
</style>
