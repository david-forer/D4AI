---
/**
 * Lead form that posts straight into self-hosted Formbricks.
 *
 * Why this exists: the hand-rolled form on /ai-automation-accelerator had no
 * action and no handler from 2025-04-30 onward, so it GET-submitted to its own
 * URL. The page reloaded, the fields went blank, and it looked like a success.
 * Sixteen months of submissions went into the access log and nowhere else.
 *
 * Formbricks keys a response by QUESTION ID, not by field name.
 *
 * TRAP, learned the hard way on 2026-09-12: this Formbricks version nests
 * fields under `blocks[].elements[]` and leaves the top-level `questions` array
 * EMPTY. Block ids sit right beside element ids and look identical. Posting to
 * a block id returns HTTP 200 and the value lands nowhere visible. Only ids
 * from `elements` are real. A 200 proves nothing. After wiring or editing any
 * survey, submit one test and read EVERY field in the dashboard.
 *
 * Value shapes per element type, all verified against the live instance:
 *   openText            -> string
 *   contactInfo         -> array, strictly [firstName, lastName, email, phone, company]
 *   multipleChoiceMulti -> array of the choice LABELS, Formbricks resolves them to ids
 */
export interface LeadFormPart {
  name: string;
  label: string;
  /**
   * `hidden` keeps a slot in the positional contactInfo array without showing a
   * field. Formbricks reads that array by position, so a part the survey hides
   * (`show: false`) must still occupy its slot or every later value shifts one
   * place and lands in the wrong column. Added 2026-09-18 for the SEO
   * Accelerator survey, which hides lastName and phone.
   */
  type?: "text" | "email" | "tel" | "url" | "hidden";
  required?: boolean;
}

export interface LeadFormField {
  /** Input name. Also the label's `for` on single inputs. */
  name: string;
  /** Formbricks ELEMENT id. Never a block id. */
  questionId: string;
  label: string;
  type?: "text" | "email" | "url" | "tel" | "textarea" | "contactInfo" | "checkboxes";
  required?: boolean;
  rows?: number;
  /** contactInfo only. Order matters and must match the Formbricks order. */
  parts?: LeadFormPart[];
  /** checkboxes only. Values are sent verbatim as labels. */
  options?: string[];
}

interface Props {
  surveyId: string;
  /**
   * Short prefix for this form's field ids, unique among the forms on one page.
   * Ids must be unique per DOCUMENT, and the homepage renders two LeadForms
   * against the same survey, so the surveyId alone cannot distinguish them.
   * Without this, both labels point at the first form's inputs and clicking a
   * label on the second form focuses the wrong field.
   */
  formId?: string;
  fields: LeadFormField[];
  heading?: string;
  buttonText?: string;
  successHeading?: string;
  successBody?: string;
  /**
   * Optional file or page handed over the moment the form succeeds. Without
   * this, a form that promises a download collects the email and then delivers
   * nothing, which is the same broken promise as a form that discards the lead.
   */
  successHref?: string;
  successLinkText?: string;
  host?: string;
  environmentId?: string;
}

const {
  surveyId,
  formId = "lf",
  fields,
  heading,
  buttonText = "Send",
  successHeading = "Got it.",
  successBody = "Your details are in. I read these myself and I will come back to you shortly.",
  successHref,
  successLinkText = "Download it now",
  host = "https://bricks.davidjforer.com",
  environmentId = "cmaydut280009oj01uzsj9v36",
} = Astro.props;

const endpoint = `${host}/api/v1/client/${environmentId}/responses`;

// The `name` attribute is deliberately untouched here. Formbricks keys the
// payload on it, so only the id and its matching label `for` are scoped.
const fieldId = (n: string) => `${formId}-${n}`;

// Fail loudly at build time rather than shipping another form that swallows
// leads. This catches a BLANK questionId. It cannot catch a WRONG one, because
// a wrong id is a plausible-looking string, which is why the dashboard check
// after wiring is not optional.
const unmapped = fields.filter((f) => !f.questionId);
if (unmapped.length > 0) {
  throw new Error(
    `LeadForm (survey ${surveyId}): no Formbricks questionId for ${unmapped
      .map((f) => f.name)
      .join(", ")}. Fill these in from the live survey before shipping, or the form will discard submissions.`,
  );
}

const badContact = fields.filter((f) => f.type === "contactInfo" && !f.parts?.length);
if (badContact.length > 0) {
  throw new Error(
    `LeadForm (survey ${surveyId}): contactInfo field "${badContact[0].name}" has no parts. Formbricks expects a fixed-order array.`,
  );
}

const spec = fields.map((f) => ({
  name: f.name,
  questionId: f.questionId,
  type: f.type ?? "text",
  parts: f.parts?.map((p) => p.name) ?? null,
}));

const inputClass =
  "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent text-gray-800";
const labelClass = "block text-gray-700 text-sm font-bold mb-2 text-left";
---

<div data-leadform data-endpoint={endpoint} data-survey={surveyId} data-spec={JSON.stringify(spec)}>
  {heading && <h3 class="text-2xl font-bold text-blue-700 mb-6">{heading}</h3>}

  <form class="space-y-4" data-leadform-form>
    {
      fields.map((f) => (
        <div>
          {f.type === "contactInfo" ? (
            <fieldset>
              <legend class={labelClass}>{f.label}</legend>
              <div class="space-y-3">
                {f.parts!.map((p) =>
                  p.type === "hidden" ? (
                    /* A hidden part exists only to hold its slot in the
                       positional contactInfo array. placeholder, aria-label,
                       required and a visible class are all invalid on
                       type="hidden" and the validator rejects them. */
                    <input type="hidden" name={`${f.name}.${p.name}`} value="" />
                  ) : (
                    <input
                      type={p.type ?? "text"}
                      name={`${f.name}.${p.name}`}
                      aria-label={p.label}
                      placeholder={p.label}
                      required={p.required ?? false}
                      class={inputClass}
                    />
                  ),
                )}
              </div>
            </fieldset>
          ) : f.type === "checkboxes" ? (
            <fieldset data-leadform-group={f.name} data-required={f.required ? "1" : "0"}>
              <legend class={labelClass}>{f.label}</legend>
              <div class="space-y-2 text-left">
                {f.options!.map((opt) => (
                  <label class="flex items-center gap-2 text-gray-800">
                    <input
                      type="checkbox"
                      name={f.name}
                      value={opt}
                      class="h-4 w-4 rounded border-gray-300 text-teal-500 focus:ring-teal-500"
                    />
                    <span>{opt}</span>
                  </label>
                ))}
              </div>
              <p data-leadform-group-error class="hidden text-sm text-red-600 mt-1">
                Please pick at least one.
              </p>
            </fieldset>
          ) : f.type === "textarea" ? (
            <>
              <label for={fieldId(f.name)} class={labelClass}>
                {f.label}
              </label>
              <textarea
                id={fieldId(f.name)}
                name={f.name}
                rows={f.rows ?? 3}
                required={f.required ?? false}
                class={inputClass}
              />
            </>
          ) : (
            <>
              <label for={fieldId(f.name)} class={labelClass}>
                {f.label}
              </label>
              <input
                type={f.type ?? "text"}
                id={fieldId(f.name)}
                name={f.name}
                required={f.required ?? false}
                class={inputClass}
              />
            </>
          )}
        </div>
      ))
    }

    <button
      type="submit"
      data-leadform-submit
      class="w-full bg-teal-500 text-white font-bold py-3 px-6 rounded-lg hover:bg-teal-600 transition duration-300 disabled:opacity-60 disabled:cursor-not-allowed"
      >{buttonText}</button
    >

    <p data-leadform-error class="hidden text-sm text-red-600 text-left" role="alert" aria-live="polite">
      That did not send. Please email <a href="mailto:david@davidjforer.com" class="underline">david@davidjforer.com</a> and I will pick it up from there.
    </p>
  </form>

  <div data-leadform-success class="hidden text-center" role="status" aria-live="polite">
    <h3 class="text-2xl font-bold text-blue-700 mb-3">{successHeading}</h3>
    <p class="text-gray-700">{successBody}</p>
    {
      successHref && (
        <a
          href={successHref}
          download
          class="mt-6 inline-block bg-teal-500 text-white font-bold py-3 px-8 rounded-lg hover:bg-teal-600 transition duration-300"
        >
          {successLinkText}
        </a>
      )
    }
  </div>
</div>

<script>
  document.querySelectorAll("[data-leadform]").forEach((root) => {
    const form = root.querySelector("[data-leadform-form]");
    const button = root.querySelector("[data-leadform-submit]");
    const errorEl = root.querySelector("[data-leadform-error]");
    const successEl = root.querySelector("[data-leadform-success]");
    if (!form || !button) return;

    const endpoint = root.getAttribute("data-endpoint");
    const surveyId = root.getAttribute("data-survey");
    const spec = JSON.parse(root.getAttribute("data-spec") || "[]");
    const originalLabel = button.textContent;

    form.addEventListener("submit", async (event) => {
      // The old form's entire bug was that the default action ran: a GET to
      // the page's own URL.
      event.preventDefault();

      if (typeof form.reportValidity === "function" && !form.reportValidity()) return;

      // Required checkbox groups are not covered by native validation.
      let groupsOk = true;
      root.querySelectorAll("[data-leadform-group]").forEach((group) => {
        const msg = group.querySelector("[data-leadform-group-error]");
        const needed = group.getAttribute("data-required") === "1";
        const any = group.querySelectorAll("input[type=checkbox]:checked").length > 0;
        if (needed && !any) {
          groupsOk = false;
          msg?.classList.remove("hidden");
        } else {
          msg?.classList.add("hidden");
        }
      });
      if (!groupsOk) return;

      errorEl?.classList.add("hidden");
      button.disabled = true;
      button.textContent = "Sending...";

      const entries = new FormData(form);
      const data = {};

      for (const field of spec) {
        if (field.type === "contactInfo") {
          // Strict order. Formbricks reads this positionally.
          const values = field.parts.map((p) => {
            const v = entries.get(`${field.name}.${p}`);
            return typeof v === "string" ? v.trim() : "";
          });
          if (values.some((v) => v !== "")) data[field.questionId] = values;
        } else if (field.type === "checkboxes") {
          const picked = entries.getAll(field.name).filter((v) => typeof v === "string");
          if (picked.length > 0) data[field.questionId] = picked;
        } else {
          const v = entries.get(field.name);
          if (typeof v === "string" && v.trim() !== "") data[field.questionId] = v.trim();
        }
      }

      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            surveyId,
            finished: true,
            data,
            meta: { url: window.location.href, source: "LeadForm" },
          }),
        });

        if (!res.ok) throw new Error(`Formbricks returned ${res.status}`);

        form.classList.add("hidden");
        successEl?.classList.remove("hidden");
      } catch (err) {
        console.error("[LeadForm] submission failed", err);
        button.disabled = false;
        button.textContent = originalLabel;
        errorEl?.classList.remove("hidden");
      }
    });
  });
</script>
