---
import ModalLeadMagnet from "../components/ModalLeadMagnet.astro";
import { GIVEAWAY_SURVEY, GIVEAWAY_FIELDS } from '../lib/leadForms';

// The modal was a Formbricks iframe until 2026-09-18. It is now a native
// LeadForm, which made it the last third-party form embed on the site.
//
// The modal promises a checklist that arrives by reply rather than an instant
// download, because that is what actually happens today. To hand over a file on
// submit instead, pass successHref and successLinkText and the button appears.
---

<section class="bg-gradient-to-r from-blue-700 to-blue-900 text-white">
  <div class="grid max-w-screen-2xl px-4 py-12 mx-auto lg:gap-8 xl:gap-0 lg:py-16 lg:grid-cols-12">
      <div class="mr-auto place-self-center lg:col-span-7">
          <h1 class="max-w-2xl mb-4 text-4xl font-extrabold tracking-tight leading-none md:text-5xl xl:text-6xl dark:text-white">Stop Running a Chaotic Business.</h1>
          <p class="max-w-2xl mb-6 font-light text-blue-100 lg:mb-8 md:text-lg lg:text-xl">Build an AI-Powered Operating System -- You've hit $1M in revenue. Your team is maxed out. It's time to install the systems that scale without you.</p>
          <div class="flex flex-wrap gap-4">
            <button
              type="button"
              data-calendly="https://calendly.com/david-j-forer/30min"
              class="cursor-pointer bg-orange-500 text-white px-6 py-3 rounded-xl hover:bg-orange-600 transition duration-200 focus:ring-2 focus:ring-orange-400 focus:ring-offset-2 focus:outline-none"
            >
              Book a Strategy Call
            </button>
            <button
              data-open-modal="ai-audit-modal"
              class="cursor-pointer bg-white/10 border border-white/30 text-white px-6 py-3 rounded-xl hover:bg-white/20 transition duration-200 focus:ring-2 focus:ring-white/50 focus:ring-offset-2 focus:outline-none"
            >
              Get the readiness checklist
            </button>
          </div>
      </div>
      <div class="hidden lg:mt-0 lg:col-span-5 lg:flex">
        {/* Click to load the player.
             The Vimeo iframe used to load on every page view. It is only shown
             at lg and up, so it was a desktop-only cost: Vimeo's player ships
             deprecated unload listeners and sets two third-party cookies
             (vuid, __cf_bm), both of which fail Best Practices, and neither is
             fixable from here because they live in Vimeo's own bundle. Nothing
             from Vimeo is requested until someone clicks. dnt=1 is Vimeo's
             do-not-track flag, which suppresses their session cookie even
             after the player loads. */}
        {/* pb-[56.25%] is 16:9, matching the source video. It was 66.66% (3:2),
             which nothing noticed while the facade was an empty gradient but
             would letterbox or crop the poster frame. */}
        <div class="relative w-full max-w-3xl pb-[56.25%] h-0 overflow-hidden">
          <button
            type="button"
            id="hero-video-play"
            data-video="https://player.vimeo.com/video/1104600587?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479&amp;dnt=1&amp;autoplay=1"
            class="hero-poster group absolute top-0 left-0 w-full h-full rounded-xl shadow-lg overflow-hidden bg-blue-900 cursor-pointer focus:outline-none focus:ring-4 focus:ring-orange-400"
          >
            {/* The scrim does two jobs. The poster is a bright frame against a
                 white wall, so white text needs it to stay readable, and the
                 blue tint keeps the facade inside the hero's palette instead of
                 sitting on it as a photo. It lightens on hover so the frame
                 reads as clickable. */}
            <span class="absolute inset-0 bg-blue-950/40 transition-colors duration-200 group-hover:bg-blue-950/25"></span>
            <span class="absolute inset-0 bg-gradient-to-t from-blue-950/80 via-blue-950/10 to-blue-950/25"></span>
            <span class="absolute inset-0 flex flex-col items-center justify-center gap-3">
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-orange-500 shadow-xl transition-transform duration-200 group-hover:scale-110">
                <svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-7 w-7 text-white" aria-hidden="true">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
              <span class="text-base font-semibold text-white drop-shadow">Are You Stuck?</span>
              <span class="text-xs uppercase tracking-[0.18em] text-blue-100 drop-shadow">Watch the 90 second intro</span>
            </span>
            <span class="sr-only">Play the intro video explaining how David helps small business owners fix their operations, marketing, and AI usage</span>
          </button>
        </div>
      </div>
  </div>

<ModalLeadMagnet
  showModalId="ai-audit-modal"
  formTitle="Get the AI readiness checklist"
  formDescription="The questions I work through before recommending a single tool. Two fields, no call."
  surveyId={GIVEAWAY_SURVEY}
  fields={GIVEAWAY_FIELDS}
  buttonText="Send it over"
  successHeading="Got it."
  successBody="Your details are in. I send this out personally, so give me a day."
/>

<style>
  /* The poster is a CSS background rather than an <img> on purpose. The whole
     video column is `hidden lg:flex`, and a display:none ancestor does not stop
     a browser downloading an <img src>, so an image tag would have cost every
     phone 42KB for something it never renders. Background images are only
     fetched once the element actually paints, and the media query makes that
     explicit, so mobile pays nothing. Same reason the Vimeo iframe was removed
     in the first place. */
  .hero-poster {
    background-color: #1e3a8a;
  }

  @media (min-width: 1024px) {
    .hero-poster {
      background-image: url("/images/hero-video-poster.webp");
      background-size: cover;
      background-position: center 35%;
    }
  }
</style>

<script>
  // Calendly, loaded on demand.
  //
  // It used to load site-wide for the benefit of this one button. The old
  // handler was `if (window.Calendly) Calendly.initPopupWidget(...)`, which
  // silently did nothing when the script had not arrived yet, so a fast
  // clicker got a dead button on the primary booking CTA.
  //
  // Now: hovering or focusing the button starts the download, so by the time
  // anyone clicks it is usually ready. A click waits for the load. If the
  // script fails outright the button navigates straight to Calendly, which
  // means the booking path can no longer end in nothing happening.
  document.addEventListener("DOMContentLoaded", () => {
    const bookButton = document.querySelector("[data-calendly]");
    if (bookButton) {
      let pending = null;

      const loadCalendly = () => {
        if (window.Calendly) return Promise.resolve();
        if (pending) return pending;
        pending = new Promise((resolve, reject) => {
          const css = document.createElement("link");
          css.rel = "stylesheet";
          css.href = "https://assets.calendly.com/assets/external/widget.css";
          document.head.appendChild(css);

          const js = document.createElement("script");
          js.src = "https://assets.calendly.com/assets/external/widget.js";
          js.async = true;
          js.onload = resolve;
          js.onerror = reject;
          document.head.appendChild(js);
        });
        return pending;
      };

      ["pointerenter", "focus", "touchstart"].forEach((event) => {
        bookButton.addEventListener(event, loadCalendly, { passive: true, once: true });
      });

      bookButton.addEventListener("click", () => {
        const url = bookButton.getAttribute("data-calendly");
        const label = bookButton.textContent;
        bookButton.textContent = "Opening...";
        loadCalendly()
          .then(() => {
            bookButton.textContent = label;
            if (window.Calendly) window.Calendly.initPopupWidget({ url });
            else window.location.href = url;
          })
          .catch(() => {
            window.location.href = url;
          });
      });
    }

    // Swap the poster button for the real player on click. autoplay=1 is on the
    // data-video URL so the click that loads it also starts it, which keeps the
    // interaction to a single click.
    const button = document.getElementById("hero-video-play");
    if (!button) return;
    button.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.src = button.getAttribute("data-video");
      frame.className = "absolute top-0 left-0 w-full h-full rounded-xl shadow-lg";
      frame.title = "Homepage intro video, Are You Stuck?";
      frame.setAttribute("frameborder", "0");
      frame.setAttribute("allow", "autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share");
      frame.setAttribute("referrerpolicy", "strict-origin-when-cross-origin");
      button.replaceWith(frame);
    });
  });
</script>
</section>

  {/* Hero Section */}
    