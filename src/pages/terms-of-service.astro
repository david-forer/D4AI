---
import Layout from "../layouts/Layout.astro";
import PageHero from '../components/PageHero.astro';
import { breadcrumbJson } from '../lib/schema';
---

<Layout
  title="Terms of Service for davidjforer.com | David J Forer"
  description="The terms that apply when you use davidjforer.com or its content, including the limits of liability. Read them before booking a call or using any download."
  image="/images/social-default.webp"
>
  <script is:inline type="application/ld+json" set:html={breadcrumbJson([['Home','/'],['Terms of Service','/terms-of-service']])} />
  {/* Blue hero band built with divs */}
  <PageHero title="Terms of Service" accent="Terms" />

  {/* Main content, centered, max-w-4xl */}
  <div class="max-w-4xl mx-auto my-12 px-4">
    <p class="mb-4">
      These Terms govern your use of our website and services. By accessing or using our website, you agree to comply with these Terms.
    </p>

    <h2 class="text-2xl font-semibold mt-8">Use of Services</h2>
    <p class="mt-2">
      You agree to use our services only for lawful purposes and in compliance with all applicable laws and regulations.
    </p>

    <h2 class="text-2xl font-semibold mt-8">Intellectual Property</h2>
    <p class="mt-2">
      All content, trademarks, and logos displayed on this site are the property of David J Forer unless otherwise stated. You may not use, copy, or distribute any content without prior written permission.
    </p>

    <h2 class="text-2xl font-semibold mt-8">Limitation of Liability</h2>
    <p class="mt-2">
      We are not liable for any damages arising from your use of our website or services, including indirect or consequential damages.
    </p>

    <h2 class="text-2xl font-semibold mt-8">Changes to Terms</h2>
    <p class="mt-2">
      We may update these Terms from time to time. Continued use of our site indicates acceptance of the updated Terms.
    </p>

    <p class="mt-8">
      Questions? Email
      <a class="text-blue-600 underline" href="mailto:david@davidjforer.com"> david@davidjforer.com</a>.
    </p>
  </div>
</Layout>
