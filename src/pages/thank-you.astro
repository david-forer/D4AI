---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout 
title="Thank You - David J Forer" 
description="Thank you for reaching out! We'll get back to you soon."
noindex={true}>
  <div class="bg-gray-50 overflow-hidden">
    
    {/* Thank You Hero Section with Blue Background */}
    <PageHero
      align="center"
      title="Thank You"
      accent="Thank You"
      text="We've received your submission and will get back to you soon."
      text2="In the meantime, feel free to explore our resources or check out our latest blog posts."
    >
      <Fragment slot="before">
        <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full" style="background: rgba(255,122,31,.18)">
          <svg class="h-10 w-10" style="color: var(--flame)" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
      </Fragment>
    </PageHero>

    {/* Action Buttons Section */}
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
          <div class="flex flex-col sm:flex-row gap-6 justify-center mb-12">
            <a 
              href="/resources" 
              class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-lg font-medium rounded-xl text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
            >
              View Resources
            </a>
            <a 
              href="/blog" 
              class="inline-flex items-center justify-center px-8 py-4 border border-gray-300 text-lg font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
            >
              Read Blog
            </a>
          </div>
          
          <div class="text-center">
            <a 
              href="/" 
              class="text-blue-600 hover:text-blue-500 font-medium text-lg transition-colors"
            >
              ← Back to Home
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
