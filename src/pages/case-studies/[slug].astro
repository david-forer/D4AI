---
// Case study template. Content lives in src/content/case-studies/<slug>.md as
// frontmatter, so a new study is a new file and no code change.
//
// Public wording rule: "an operations audit I performed". Nothing about where or
// for whom the audits were done (David, 2026-10-07).
//
// The video block renders only when the entry has a videoUrl. There is no
// placeholder, because a "video coming soon" box on a proof page costs trust.
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbJson } from '../../lib/schema';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const studies = (await getCollection('case-studies', ({ data }) => !data.draft))
    .sort((a, b) => a.data.order - b.data.order);
  return studies.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, next: studies.length > 1 ? studies[(i + 1) % studies.length] : null },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;

// YouTube and Vimeo links become embeddable ones.
function toEmbedUrl(url: string): string | null {
  const yt = url.match(/youtube\.com\/watch\?v=([\w-]+)/) || url.match(/youtu\.be\/([\w-]+)/);
  if (yt) return `https://www.youtube.com/embed/${yt[1]}`;
  if (url.includes('youtube.com/embed/') || url.includes('player.vimeo.com/video/')) return url;
  const vm = url.match(/vimeo\.com\/(\d+)/);
  if (vm) return `https://player.vimeo.com/video/${vm[1]}`;
  return null;
}
const embedUrl = d.videoUrl ? toEmbedUrl(d.videoUrl) : null;
---

<Layout title={d.seoTitle ?? d.title} description={d.description}>
  <script is:inline type="application/ld+json" set:html={breadcrumbJson([['Home','/'],[d.title,'/case-studies/'+entry.slug]])} />
  <PageHero
    eyebrow="Case study"
    title={d.title}
    accent={d.accent}
    text="An operations audit I performed, before AI was part of the work. The business is anonymized and described broadly so it can't be identified."
  >
    <a slot="before" class="ph-back" href="/#case-studies">&larr; Back to the proof</a>
    <div slot="meta" class="facts">
      {d.facts.map((f) => (
        <div class="fact"><small>{f.label}</small><b>{f.value}</b></div>
      ))}
    </div>
  </PageHero>

  {embedUrl && (
    <section class="video-sec">
      <div class="wrap">
        <div class="video">
          <iframe src={embedUrl} title={d.videoTitle ?? d.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
        {d.videoTitle && <p class="video-cap"><b>{d.videoTitle}</b>{d.videoText ? ` ${d.videoText}` : ''}</p>}
      </div>
    </section>
  )}

  <section class="cost">
    <div class="wrap grid">
      <div>
        <p class="tag sec-head">What it cost</p>
        <h2>{d.cost.heading}</h2>
        <p class="lede">{d.cost.intro}</p>
      </div>
      <div class="receipt-wrap">
        <div class="receipt">
          <div class="r-head"><b>{d.cost.receiptTitle}</b><span class="stamp">Estimate</span></div>
          {d.cost.lines.map((l) => (
            <div class="cline">
              <div class="row"><span>{l.label}</span><output>{l.value}</output></div>
              <p class="work">{l.work}</p>
            </div>
          ))}
          {d.cost.foot && <div class="r-foot">{d.cost.foot}</div>}
        </div>
      </div>
    </div>
  </section>

  <section class="find">
    <div class="wrap">
      <p class="tag sec-head">What the audit found</p>
      <h2>{d.findingsHeading}</h2>
      <div class="rows">
        {d.findings.map((f, i) => (
          <div class="item">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{f.title}</h3>
              {f.paragraphs.map((p) => <p>{p}</p>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="rec">
    <div class="wrap">
      <p class="tag sec-head">What we recommended</p>
      <h2>{d.recsHeading}</h2>
      <div class="cards">
        {d.recs.map((r) => (
          <div class="card"><span class="k">{r.label}</span><p>{r.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="auto">
    <div class="wrap">
      <p class="tag sec-head">What I'd automate today</p>
      <h2>The same audit, with AI doing part of the work.</h2>
      <p class="note">This section is new. The audit above was an operations audit only. This is what I'd add now that AI tools can carry part of the work.</p>
      <div class="acards">
        {d.automate.map((a) => (
          <div class="acard"><h3>{a.title}</h3><p>{a.text}</p></div>
        ))}
        <div class="acard yours"><h3>Your version</h3><p>The $750 audit finds the first three of these in your business and prices each one.</p></div>
      </div>
    </div>
  </section>

  {d.stops && <p class="stops">{d.stops}</p>}

  {next && (
    <section class="next">
      <div class="wrap">
        <a class="next-link" href={`/case-studies/${next.slug}`}>
          <span class="tag">Next case study</span>
          <b>{next.data.title}</b>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  )}

  <CtaBand
    title="Want this for your business?"
    text="The same questions, asked about your work. Fixed price, and you keep everything."
    primaryLabel="Book a call"
    primaryHref="https://calendly.com/david-j-forer/30min"
    secondaryLabel="See the $750 audit"
    secondaryHref="/ai-readiness-and-ai-audits#pricing"
  />
</Layout>

<style>
  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 28px; }
  .tag { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; font-weight: 500; }
  .sec-head { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; color: var(--orange); }
  .sec-head::before { content: ""; width: 44px; height: 2px; background: currentColor; flex: none; }
  h2, h3 { letter-spacing: -.03em; line-height: 1.05; }
  section, .stops { font-size: 18px; line-height: 1.6; }

  /* facts strip, inside the hero */
  .facts { margin-top: 18px; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); border: 1px solid var(--navy-line); border-radius: 14px; overflow: hidden; background: rgba(255,255,255,.03); }
  .fact { padding: 16px 18px; border-right: 1px solid var(--navy-line); }
  .fact:last-child { border-right: 0; }
  .fact small { display: block; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--blue-ice); font-weight: 500; }
  .fact b { display: block; margin-top: 6px; font-size: 19px; font-weight: 700; letter-spacing: -.02em; line-height: 1.2; color: #fff; }

  /* video */
  .video-sec { background: var(--navy); padding: 0 0 80px; }
  .video { position: relative; aspect-ratio: 16 / 9; border-radius: 18px; overflow: hidden; border: 1px solid var(--navy-line); background: #000; box-shadow: 0 30px 60px rgba(0,0,0,.4); }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .video-cap { margin-top: 16px; color: var(--blue-ice); font-size: 16px; }
  .video-cap b { color: #fff; }

  /* cost receipt */
  .cost { background: var(--paper); color: var(--ink); padding: 100px 0; }
  .cost .grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 70px; align-items: center; }
  .cost h2 { font-size: clamp(34px, 4.4vw, 56px); font-weight: 800; }
  .cost .lede { margin-top: 20px; color: var(--ink-2); max-width: 420px; }
  .receipt-wrap { position: relative; filter: drop-shadow(0 26px 34px rgba(15,23,41,.22)); transform: rotate(1.2deg); max-width: 520px; justify-self: end; width: 100%; }
  .receipt { position: relative; background: var(--slip); padding: 26px 26px 30px; font-variant-numeric: tabular-nums; }
  .receipt::after { content: ""; position: absolute; left: 0; right: 0; top: 100%; height: 12px; background: var(--slip); -webkit-mask: conic-gradient(from 135deg at top, #0000, #000 1deg 89deg, #0000 90deg) 50% / 20px 100%; mask: conic-gradient(from 135deg at top, #0000, #000 1deg 89deg, #0000 90deg) 50% / 20px 100%; }
  .r-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 14px; border-bottom: 2px dashed var(--ink); }
  .r-head b { font-size: 13px; letter-spacing: .14em; font-weight: 700; }
  .stamp { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; padding: 3px 9px; border: 1.5px solid var(--orange); color: var(--orange); transform: rotate(-3deg); }
  .cline { padding: 14px 0; border-bottom: 1px dotted var(--rule); }
  .cline .row { display: flex; align-items: baseline; gap: 8px; }
  .cline .row span { font-size: 15px; font-weight: 600; }
  .cline .row::after { content: ""; order: 2; flex: 1; border-bottom: 2px dotted var(--rule); transform: translateY(-4px); }
  .cline .row output { order: 3; font-size: 21px; font-weight: 800; letter-spacing: -.02em; color: var(--orange); white-space: nowrap; }
  .cline .work { margin-top: 4px; font-size: 13.5px; color: var(--ink-2); line-height: 1.4; }
  .r-foot { margin-top: 6px; padding-top: 12px; border-top: 2px dashed var(--ink); font-size: 13.5px; color: var(--ink-2); line-height: 1.4; }

  /* findings */
  .find { background: var(--paper-2); color: var(--ink); padding: 100px 0; }
  .find h2, .rec h2, .auto h2 { font-size: clamp(34px, 4.4vw, 56px); font-weight: 800; max-width: 18ch; }
  .rows { margin-top: 48px; border-top: 4px solid var(--ink); }
  .item { display: grid; grid-template-columns: 96px 1fr; gap: 22px; padding: 34px 0; border-bottom: 1px solid var(--rule); }
  .item .n { font-weight: 800; font-size: 68px; line-height: .85; color: transparent; -webkit-text-stroke: 2px var(--orange); font-variant-numeric: tabular-nums; }
  .item h3 { font-size: 28px; font-weight: 700; margin-bottom: 12px; }
  .item p { color: var(--ink-2); max-width: 680px; }
  .item p + p { margin-top: 12px; }

  /* recommendations */
  .rec { background: var(--paper); color: var(--ink); padding: 100px 0; }
  .cards { margin-top: 48px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .card { background: var(--slip); border: 1.5px solid var(--ink); padding: 26px 24px; display: flex; flex-direction: column; }
  .card .k { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); font-weight: 600; margin-bottom: 12px; }
  .card p { font-size: 16px; color: var(--ink-2); line-height: 1.55; }

  /* what I'd automate today */
  .auto { background: var(--navy); color: #fff; padding: 100px 0; }
  .auto .sec-head { color: var(--flame); }
  .auto h2 { color: #fff; }
  .note { margin-top: 20px; max-width: 640px; color: var(--blue-ice); font-size: 17px; }
  .acards { margin-top: 48px; display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--navy-line); }
  .acard { padding: 28px 26px; border-right: 1px solid var(--navy-line); border-bottom: 1px solid var(--navy-line); }
  .acard h3 { font-size: 22px; font-weight: 700; margin-bottom: 10px; color: #fff; }
  .acard p { font-size: 16px; color: var(--blue-ice); }
  .acard.yours { background: rgba(255,122,31,.08); }

  .stops { background: var(--paper); padding: 46px 28px; text-align: center; color: var(--ink-2); font-size: 16px; }

  /* next case study */
  .next { background: var(--paper-2); padding: 0 0 60px; }
  .next-link { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; padding: 22px 26px; background: var(--slip); border: 1.5px solid var(--ink); text-decoration: none; color: var(--ink); transition: transform .25s var(--ease), box-shadow .25s var(--ease); }
  .next-link:hover { transform: translateY(-4px); box-shadow: 6px 6px 0 var(--ink); }
  .next-link:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }
  .next-link .tag { color: var(--orange); }
  .next-link b { flex: 1; min-width: 220px; font-size: 22px; font-weight: 700; letter-spacing: -.02em; line-height: 1.2; }
  .next-link .arrow { font-size: 24px; color: var(--orange); }

  @media (max-width: 900px) {
    .cost .grid { grid-template-columns: 1fr; gap: 44px; }
    .receipt-wrap { justify-self: center; }
    .cards, .acards { grid-template-columns: 1fr; }
    .fact { border-bottom: 1px solid var(--navy-line); }
  }
  @media (max-width: 520px) {
    section, .stops { font-size: 17px; }
    .wrap { padding: 0 20px; }
    .item { grid-template-columns: 64px 1fr; }
    .item .n { font-size: 46px; }
    .cost, .find, .rec, .auto { padding: 64px 0; }
  }
  @media (prefers-reduced-motion: reduce) { .next-link { transition: none; } }
</style>
