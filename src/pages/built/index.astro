---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allBuilds = await getCollection('builds', ({ data }) => data.status !== 'archived');

const byRank = (a: any, b: any) =>
  Number(b.data.featured) - Number(a.data.featured) ||
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const apps = allBuilds.filter(b => b.data.buildType === 'app').sort(byRank);
const skills = allBuilds.filter(b => b.data.buildType === 'skill').sort(byRank);
const agents = allBuilds.filter(b => b.data.buildType === 'agent').sort(byRank);

const sections = [
  {
    id: 'apps',
    label: 'Apps',
    heading: 'Apps',
    blurb: 'Standalone tools with an interface. Things you open, click around in, and use.',
    items: apps,
  },
  {
    id: 'skills',
    label: 'Skills',
    heading: 'Skills',
    blurb: 'Written procedures that teach Claude Code how to do a job my way, every time. A skill is repeatable expertise in a file.',
    items: skills,
  },
  {
    id: 'agents',
    label: 'Agents',
    heading: 'Agents',
    blurb: 'Systems that run on their own schedule and do real work while I do something else. Each one has guardrails and an approval step.',
    items: agents,
  },
];

const badgeColors: Record<string, string> = {
  app: 'bg-emerald-100 text-emerald-800',
  skill: 'bg-amber-100 text-amber-800',
  agent: 'bg-blue-100 text-blue-800',
};
---

<Layout
  title="Built by David | Apps, Skills, and Agents"
  description="A working catalog of the apps, Claude Code skills, and autonomous agents David J Forer has built with AI and for AI."
>
  {/* Hero */}
  <section class="bg-gradient-to-r from-blue-600 to-blue-800 py-24">
    <div class="container mx-auto px-6 max-w-7xl">
      <div class="max-w-3xl">
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">Things I have built</h1>
        <p class="text-blue-100 text-xl mb-6 leading-relaxed">
          I build with AI and for AI. Apps I use every day, skills that teach Claude to work my way, and agents that run my business while I sleep. Everything here runs in production on my own machines.
        </p>
        <p class="text-blue-100 text-xl mb-10 leading-relaxed">
          Each one has its own page with a breakdown of what it does and how it works. Videos and source links are being added as I record them.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#apps" class="bg-white text-blue-700 font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-blue-50 transition duration-300">Apps</a>
          <a href="#skills" class="bg-white text-blue-700 font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-blue-50 transition duration-300">Skills</a>
          <a href="#agents" class="bg-white text-blue-700 font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-blue-50 transition duration-300">Agents</a>
        </div>
      </div>
    </div>
  </section>

  {/* Why I build */}
  <section class="py-16 bg-white">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="text-center mb-4">
        <h2 class="text-3xl font-bold text-blue-700 mb-4">Building with AI and for AI</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Every tool here started as a bottleneck in my own operations. I build the fix, run it until it is boring and reliable, then bring the same pattern to client work. This page is the proof behind the consulting.
        </p>
      </div>
    </div>
  </section>

  {sections.map((section, i) => (
    <section id={section.id} class={`py-16 ${i % 2 === 0 ? 'bg-gray-100' : 'bg-white'}`}>
      <div class="container mx-auto px-6 max-w-7xl">
        <div class="mb-10">
          <h2 class="text-3xl font-bold text-blue-700 mb-3">{section.heading}</h2>
          <p class="text-lg text-gray-600 max-w-3xl">{section.blurb}</p>
        </div>

        {section.items.length === 0 ? (
          <p class="text-gray-500 italic">More coming soon.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {section.items.map(item => (
              <a
                href={`/built/${item.slug}`}
                class="block bg-white rounded-lg shadow-md hover:shadow-xl transition duration-300 border-t-4 border-blue-600 p-6 group"
              >
                <div class="flex items-center justify-between mb-4">
                  <span class={`text-xs font-semibold uppercase tracking-wide px-2 py-1 rounded ${badgeColors[item.data.buildType]}`}>
                    {item.data.buildType}
                  </span>
                  {item.data.status === 'in-progress' && (
                    <span class="text-xs font-medium text-gray-500">in progress</span>
                  )}
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-2 group-hover:text-blue-600 transition duration-150">
                  {item.data.title}
                </h3>
                <p class="text-gray-600 mb-4">{item.data.description}</p>
                {item.data.stack && (
                  <div class="flex flex-wrap gap-2 mb-4">
                    {item.data.stack.map(tech => (
                      <span class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded">{tech}</span>
                    ))}
                  </div>
                )}
                <span class="text-blue-600 font-medium text-sm">See the breakdown →</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  {/* CTA */}
  <section class="py-16 bg-gradient-to-r from-blue-600 to-blue-800">
    <div class="container mx-auto px-6 max-w-4xl text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Want something like this in your business?</h2>
      <p class="text-blue-100 text-xl mb-8">
        Every one of these started as a repetitive task that ate a founder's week. If you have one of those, let's talk about it.
      </p>
      <a
        href="https://calendly.com/david-j-forer/30min"
        class="inline-block bg-white text-blue-700 font-bold py-4 px-10 rounded-lg shadow-lg hover:bg-blue-50 transition duration-300 text-lg"
      >
        Book a 30 minute call
      </a>
    </div>
  </section>
</Layout>
