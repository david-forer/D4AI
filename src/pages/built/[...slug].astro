---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const builds = await getCollection('builds');
  return builds.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const typeLabels: Record<string, string> = {
  app: 'App',
  skill: 'Claude Code skill',
  agent: 'Autonomous agent',
};

const badgeColors: Record<string, string> = {
  app: 'bg-emerald-100 text-emerald-800',
  skill: 'bg-amber-100 text-amber-800',
  agent: 'bg-blue-100 text-blue-800',
};

// Turn a YouTube watch or share URL into an embeddable one
function toEmbedUrl(url: string): string | null {
  const watch = url.match(/youtube\.com\/watch\?v=([\w-]+)/);
  if (watch) return `https://www.youtube.com/embed/${watch[1]}`;
  const short = url.match(/youtu\.be\/([\w-]+)/);
  if (short) return `https://www.youtube.com/embed/${short[1]}`;
  if (url.includes('youtube.com/embed/')) return url;
  return null;
}

const videoUrl = entry.data.videoUrl || '';
const embedUrl = videoUrl ? toEmbedUrl(videoUrl) : null;
---

<Layout title={entry.data.seoTitle || `${entry.data.title} | Forersight`} description={entry.data.description}>
  {/* Header */}
  <section class="bg-gradient-to-r from-blue-600 to-blue-800 py-16">
    <div class="container mx-auto px-6 max-w-4xl">
      <a href="/built" class="text-blue-200 hover:text-white text-sm font-medium transition duration-150">
        ← Back to everything I have built
      </a>
      <div class="mt-6 flex items-center gap-3">
        <span class={`text-xs font-semibold uppercase tracking-wide px-2 py-1 rounded ${badgeColors[entry.data.buildType]}`}>
          {typeLabels[entry.data.buildType]}
        </span>
        {entry.data.status === 'in-progress' && (
          <span class="text-xs font-medium text-blue-200">in progress</span>
        )}
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-white mt-4 mb-4">{entry.data.title}</h1>
      <p class="text-blue-100 text-xl leading-relaxed">{entry.data.description}</p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        {entry.data.githubUrl && (
          <a
            href={entry.data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center bg-white text-blue-700 font-bold py-2 px-6 rounded-lg shadow hover:bg-blue-50 transition duration-300"
          >
            View on GitHub
          </a>
        )}
        {entry.data.stack && (
          <div class="flex flex-wrap gap-2">
            {entry.data.stack.map(tech => (
              <span class="text-xs bg-blue-500 bg-opacity-40 text-white px-2 py-1 rounded">{tech}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  {/* Video */}
  {videoUrl && (
    <section class="py-12 bg-gray-100">
      <div class="container mx-auto px-6 max-w-4xl">
        <h2 class="text-2xl font-bold text-blue-700 mb-6">See it working</h2>
        {embedUrl ? (
          <div class="relative w-full rounded-lg shadow-lg overflow-hidden" style="padding-bottom: 56.25%;">
            <iframe
              src={embedUrl}
              title={`${entry.data.title} demo video`}
              class="absolute top-0 left-0 w-full h-full"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        ) : (
          <video controls class="w-full rounded-lg shadow-lg" src={videoUrl}></video>
        )}
      </div>
    </section>
  )}

  {/* Body */}
  <section class="py-16 bg-white">
    <div class="container mx-auto px-6 max-w-4xl">
      <article class="prose prose-lg max-w-none">
        <Content />
      </article>
    </div>
  </section>

  {/* CTA */}
  <section class="py-16 bg-gray-100">
    <div class="container mx-auto px-6 max-w-4xl text-center">
      <h2 class="text-2xl font-bold text-gray-800 mb-4">Curious what this could do for your business?</h2>
      <p class="text-gray-600 text-lg mb-8">I build systems like this for founders who are done being the bottleneck.</p>
      <a
        href="https://calendly.com/david-j-forer/30min"
        class="inline-block bg-blue-600 text-white font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-blue-700 transition duration-300"
      >
        Book a 30 minute call
      </a>
    </div>
  </section>
</Layout>

<style is:global>
  .prose h2 {
    font-size: 1.75rem;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: #1d4ed8;
    font-weight: 700;
  }

  .prose h2:first-of-type {
    margin-top: 0;
  }

  .prose h3 {
    font-size: 1.5rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #1d4ed8;
    font-weight: 700;
  }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .prose ul, .prose ol {
    margin-left: 2rem;
    margin-bottom: 1.25rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose a {
    color: #2563eb;
    text-decoration: underline;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
  }
</style>
