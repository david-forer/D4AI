
---
import Layout from '../layouts/Layout.astro'

const gpts = [
  {
    title: "Super Operational GPT",
    description: "Helps small business owners find and fix operational bottlenecks.",
    url: "https://chatgpt.com/g/g-GEszZbdu9-super-operational-gpt"
  },
  {
    title: "SOP Specialist",
    description: "Writes standard operating procedures for small businesses.",
    url: "https://chatgpt.com/g/g-Hy21onPGp-sop-specialist"
  },
  {
    title: "Support Response Assistant",
    description: "Drafts clear, calm replies to customer emails.",
    url: "https://chatgpt.com/g/g-XbxXyIAZY-support-response-assistant"
  },
  {
    title: "SEO AI Writer",
    description: "Writes AI and SEO articles to a set structure.",
    url: "https://chatgpt.com/g/g-7wW7TkdeV-seo-ai-writer"
  },
  {
    title: "SEO Entity Analyzer",
    description: "Checks content for entity coverage and semantic SEO gaps.",
    url: "https://chatgpt.com/g/g-fTCVWOKBW-seo-entity-analyzer"
  },
  {
    title: "LI Article Builder",
    description: "Builds LinkedIn posts fast, in a plain, conversational tone.",
    url: "https://chatgpt.com/g/g-6r5wljozn-li-pro-writer"
  },
  {
    title: "Resume Maestro",
    description: "Rewrites your resume to match a specific job listing.",
    url: "https://chatgpt.com/g/g-0KPALERM8-resume-meastro"
  },
  {
    title: "Solara, The Inner Compass Coach",
    description: "Helps you think through a tough choice and see it clearly. Built with founders and freelancers in mind.",
    url: "https://chatgpt.com/g/g-684c0250f458819180fad3f55e6fffb8-solara-the-inner-compass-coach"
  },
  {
    title: "Visionary Ideas",
    description: "A lightweight assistant for brainstorming ideas and sharpening the good ones.",
    url: "https://chatgpt.com/g/g-WXoEiVTGr-visionary-ideas"
  }
]
---

<Layout title="Custom GPTs made by David J Forer | AI Assistants for Business & Creativity"
description="Free custom GPTs built by David J Forer for small business work, like SOPs, support replies and SEO writing. Open one in ChatGPT and use it today."
image="/images/Custom-GPTs.webp">
  {/* Blue Hero/Header Section */}
  <section class="bg-gradient-to-r from-blue-600 to-blue-800 py-24 relative overflow-hidden">
        {/* Background texture. Hexagons, a modular motif for a set of assistants. Decorative only. */}
        <div class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true">
            <div class="absolute top-20 left-20 w-48 h-48 bg-violet-200" style="clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%)"></div>
            <div class="absolute bottom-16 right-24 w-64 h-64 bg-fuchsia-200" style="clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%)"></div>
            <div class="absolute top-1/2 left-1/2 w-28 h-28 bg-purple-100" style="clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%)"></div>
        </div>
    <div class="container mx-auto px-6 max-w-6xl relative z-10">
      <div class="text-center">
        <div>
          <h1 class="text-5xl md:text-7xl font-bold text-white mb-6">Custom GPTs</h1>
          <h2 class="text-2xl md:text-3xl text-blue-100 mb-8">AI assistants for business and creative work</h2>
          <p class="text-white text-xl mb-10 leading-relaxed">Free AI assistants I built for my own work. Open one in ChatGPT and use it today.</p>
          <a href="#explore-gpts" class="bg-white text-blue-700 font-bold py-4 px-10 rounded-lg shadow-lg hover:bg-blue-50 transition duration-300 text-lg">See the GPTs</a>
        </div>

      </div>
    </div>
  </section>

  {/* What are Custom GPTs Section */}
  <section class="py-16 bg-white">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-blue-700 mb-4">What are custom GPTs?</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">Custom GPTs are ChatGPT assistants set up with fixed instructions for one job.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-gray-50 p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300 border-t-4 border-blue-600">
          <h3 class="text-xl font-bold text-gray-800 mb-3">Built for one task</h3>
          <p class="text-gray-600">Each one is set up for a single job, such as writing SOPs or answering support email.</p>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300 border-t-4 border-blue-600">
          <h3 class="text-xl font-bold text-gray-800 mb-3">Your own material</h3>
          <p class="text-gray-600">You can give a custom GPT your own documents to work from, so its answers use your material.</p>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300 border-t-4 border-blue-600">
          <h3 class="text-xl font-bold text-gray-800 mb-3">Time back</h3>
          <p class="text-gray-600">They handle routine drafting, so you start from a first version and not a blank page.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Benefits Section */}
  <section class="py-16 bg-slate-200">
    <div class="container mx-auto px-6 max-w-5xl">
      <h2 class="text-3xl font-bold text-blue-700 mb-16 text-center">Why use a custom GPT</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="bg-white p-8 rounded-lg shadow-md">
          <h3 class="text-2xl font-bold text-gray-800 mb-6">For businesses</h3>
          
          <ul class="space-y-4">
            <li class="flex items-start">
              <span class="text-blue-700 mr-3 mt-1">✓</span>
              <span>Routine steps stop waiting on you.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-700 mr-3 mt-1">✓</span>
              <span>Customer emails and documents follow the same structure each time.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-700 mr-3 mt-1">✓</span>
              <span>Routine tasks take less of your team's time.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-700 mr-3 mt-1">✓</span>
              <span>You can take on more work before you need another hire.</span>
            </li>
          </ul>
        </div>
        
        <div class="bg-white p-8 rounded-lg shadow-md">
          <h3 class="text-2xl font-bold text-gray-800 mb-6">For individuals</h3>
          
          <ul class="space-y-4">
            <li class="flex items-start">
              <span class="text-blue-700 mr-3 mt-1">✓</span>
              <span>Routine tasks get done faster.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-700 mr-3 mt-1">✓</span>
              <span>You learn a subject by working through it with an assistant built for it.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-700 mr-3 mt-1">✓</span>
              <span>You see both sides of a hard choice before you make it.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-700 mr-3 mt-1">✓</span>
              <span>You get unstuck when the blank page wins.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* GPTs Grid Section */}
  <section id="explore-gpts" class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-blue-700 mb-10 text-center">Explore my free AI assistants</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {gpts.map(gpt => (
          <div class="bg-white shadow-lg rounded-2xl p-6 border border-gray-200 hover:shadow-xl transition-all duration-300">
            <h3 class="text-xl font-semibold text-blue-700 mb-2">{gpt.title}</h3>
            <p class="text-gray-700 mb-4">{gpt.description}</p>
            <a href={gpt.url} class="text-blue-600 hover:underline font-medium">Try this GPT →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="bg-gradient-to-r from-blue-600 to-blue-800 py-16">
    <div class="container mx-auto px-6 max-w-5xl text-center">
      <h2 class="text-3xl font-bold text-white mb-6">Need a custom GPT for your business?</h2>
      <p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">I can build a custom GPT around how your business runs.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/contact" class="bg-white text-blue-700 font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-blue-50 transition duration-300">Talk to me about a custom GPT</a>
        <a href="/services" class="bg-transparent text-white border-2 border-white font-bold py-3 px-8 rounded-lg hover:bg-blue-700 transition duration-300">See my services</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .text-gradient {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 400%;
    background-position: 0%;
  }
</style>
