---
import Layout from '../layouts/Layout.astro';
import ReadinessQuiz from '../components/ReadinessQuiz.astro';
import { CATEGORIES, ARCHETYPES } from '../lib/readinessQuiz.js';

const pageUrl = 'https://davidjforer.com/ai-readiness-snapshot';
const datePublished = '2026-09-15';
const dateModified = '2026-09-15';

const categories = Object.values(CATEGORIES);

const faqs = [
  {
    q: 'What is an AI readiness assessment?',
    a: 'It measures whether a business can actually get value from AI, rather than whether it has bought AI tools. The things that decide that are unglamorous: whether processes are written down, whether the software can be connected to anything, how much of the operation runs through the owner, and whether useful discoveries get shared or stay with one person. A business can be using AI every day and still be unready, because none of it compounds.',
  },
  {
    q: 'How long does the assessment take?',
    a: 'About five minutes. There are twenty-two questions and most of them are one click. Your answers are kept as you go, so you can close the tab and come back to the same place in the same browser session.',
  },
  {
    q: 'Why does it ask how many hours I spend on work someone else could do?',
    a: 'Because that number, multiplied out across a year and priced at what a founder hour is actually worth, is usually the single largest cost in the business and almost nobody has calculated it. The result gives you that figure as a range along with the arithmetic used to reach it, so you can argue with the assumptions rather than take it on faith.',
  },
  {
    q: 'Is this a sales pitch?',
    a: 'The result recommends an audit tier, so yes, there is an offer at the end. The assessment itself still works if you ignore it. You get your score, your weakest area, a cost estimate, and a specific first move, and none of that requires you to buy anything or book a call.',
  },
  {
    q: 'How accurate is the cost estimate?',
    a: 'It is a rough estimate built from what you tell it, which is why it is shown as a range rather than a single number, and it deliberately uses conservative inputs. Forty-six working weeks rather than fifty-two, and only two cost lines rather than every cost that could be argued for. A real audit measures the same things from evidence and interviews rather than recall, and it usually finds the number is higher than the self-assessment suggested.',
  },
  {
    q: 'What happens to my answers?',
    a: 'They are used to generate your result and they come to me. I read them. There is no data sale, no advertising pixel keyed to your responses, and no sequence you cannot leave in one click.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: 'The AI Readiness Snapshot: A Free 5-Minute Assessment',
      description:
        'A free self-assessment for founder-led businesses. Score your operation across process clarity, founder dependency, system readiness and AI practice, and get an estimate of what the gaps cost you per year.',
      mainEntityOfPage: pageUrl,
      url: pageUrl,
      datePublished,
      dateModified,
      author: { '@type': 'Person', name: 'David J Forer', url: 'https://davidjforer.com/about' },
      publisher: { '@type': 'Person', name: 'David J Forer', url: 'https://davidjforer.com' },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="The AI Readiness Snapshot: A Free 5-Minute Assessment | Score Your Business Across Process Clarity, Founder Dependency, System Readiness and AI Practice, and See What the Gaps Are Costing You Every Year | David J Forer"
  description="A free five-minute assessment for founder-led businesses. Find out whether your operation is ready for AI, which area is weakest, and roughly what the gaps cost you per year."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section class="pt-16 pb-12 sm:pt-24 sm:pb-16">
    <div class="max-w-3xl mx-auto px-4">
      <p class="text-sm font-semibold uppercase tracking-wide text-[color:var(--primary)] mb-4">
        Free assessment, no call required
      </p>
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 leading-tight mb-6">
        Most businesses are not held back by AI. They are held back by what AI has nothing to work
        with.
      </h1>
      <p class="text-xl text-gray-600 leading-relaxed mb-6">
        AI multiplies whatever system it lands on. Land it on documented, connected processes and it
        compounds. Land it on tribal knowledge and browser tabs and it produces one clever demo,
        then quietly stops getting used.
      </p>
      <p class="text-xl text-gray-600 leading-relaxed mb-10">
        This assessment tells you which of those two situations you are in, which area is weakest,
        and roughly what the gap is costing you every year. Twenty-two questions, about five
        minutes.
      </p>

      <div class="flex flex-wrap gap-4 items-center">
        <a
          href="#quiz"
          class="inline-block bg-[color:var(--primary)] hover:bg-[color:var(--primary-hover)] text-white font-semibold text-lg px-6 py-3 rounded-xl transition"
          >Start the assessment</a
        >
        <span class="text-sm text-gray-500">No card, no call, result on screen</span>
      </div>
    </div>
  </section>

  <!-- Quiz -->
  <section class="pb-20">
    <div class="max-w-5xl mx-auto px-4">
      <ReadinessQuiz />
    </div>
  </section>

  <!-- What it measures -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">What it measures</h2>
      <p class="text-lg text-gray-600 mb-10 max-w-2xl">
        Four areas. Each one is a precondition for the next thing working, which is why they are
        scored separately rather than rolled into a single number.
      </p>
      <div class="grid sm:grid-cols-2 gap-6">
        {
          categories.map((c) => (
            <div class="bg-white border border-gray-200 rounded-2xl p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-3">{c.name}</h3>
              <p class="text-gray-600 leading-relaxed">{c.blurb}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Archetypes -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">The four results</h2>
      <p class="text-lg text-gray-600 mb-10 max-w-2xl">
        Everyone lands in one of these. The order matters more than the label, because the move that
        works in one position is usually wasted in another.
      </p>
      <div class="space-y-4">
        {
          ARCHETYPES.map((a, i) => (
            <div class="border border-gray-200 rounded-2xl p-6 flex gap-5">
              <div class="shrink-0 w-10 h-10 rounded-full bg-gray-900 text-white flex items-center justify-center font-bold">
                {i + 1}
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900 mb-1">{a.name}</h3>
                <p class="text-gray-500 mb-3">{a.line}</p>
                <p class="text-gray-700 leading-relaxed">{a.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-10">Questions about the assessment</h2>
      <div class="space-y-8">
        {
          faqs.map((f) => (
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">{f.q}</h3>
              <p class="text-gray-700 leading-relaxed">{f.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 mb-8">Related reading</h2>
      <div class="space-y-5">
        <a href="/ai-readiness-and-ai-audits" class="block group">
          <h3 class="text-xl font-bold text-blue-700 group-hover:underline">
            AI readiness and AI audits
          </h3>
          <p class="text-gray-600">
            What a full audit covers, what you get at each tier, and what it costs.
          </p>
        </a>
        <a href="/founder-bottleneck-test" class="block group">
          <h3 class="text-xl font-bold text-blue-700 group-hover:underline">
            The founder bottleneck test: six signs, in order
          </h3>
          <p class="text-gray-600">
            The six signs you have become the bottleneck, earliest to latest, each with a check you
            can run this week.
          </p>
        </a>
        <a href="/founder-bottlenecks" class="block group">
          <h3 class="text-xl font-bold text-blue-700 group-hover:underline">
            Founder bottlenecks
          </h3>
          <p class="text-gray-600">
            Why owner dependency forms, what it costs, and how to unwind it without dropping the
            quality that got you here.
          </p>
        </a>
      </div>
    </div>
  </section>
</Layout>
