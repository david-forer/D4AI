---
import Layout from '../layouts/Layout.astro';

const pageUrl = 'https://davidjforer.com/ai-readiness-and-ai-audits';

// Bump when the page content materially changes. A dateModified that never
// moves is worse than none.
const dateModified = '2026-09-12';

// Mirrors the visible FAQ section verbatim. Google requires the marked-up
// answer to match what a visitor actually reads, so edit both or neither.
const faqs = [
  {
    q: 'How long does the AI Audit take?',
    a: 'The complete audit process takes approximately 5-7 days from kickoff to final delivery, including interviews, analysis, and report creation.',
  },
  {
    q: 'Do I need technical knowledge about AI?',
    a: 'No technical knowledge is required. We explain everything in business terms and provide guidance on implementation regardless of your technical background.',
  },
  {
    q: 'Will this disrupt our current operations?',
    a: 'The audit process is designed to be minimally disruptive, requiring only 1-2 hours of your time for interviews. Implementation follows a phased approach you control.',
  },
  {
    q: 'Is my business too small for AI?',
    a: 'Not at all. Our AI Audit is specifically designed for small businesses around $1M in revenue who want to scale without adding headcount.',
  },
  {
    q: "What if we've never used AI before?",
    a: 'That is often the best starting point. The audit will identify the best entry points for AI in your business and provide a step-by-step implementation plan to get started.',
  },
  {
    q: 'Do you help with implementation?',
    a: 'Yes. We provide implementation planning as part of the audit, and we offer additional implementation services if you need hands-on assistance.',
  },
];

// The five delivery phases, taken from the visible "Our AI Readiness Audit
// Process" section.
const phases = [
  'Preparation and Context',
  'Interviews and Discovery',
  'Readiness Analysis',
  'Findings and Synthesis',
  'Delivery and Next-Step Planning',
];

// No `offers` block. The audit price is decided internally but not published,
// and inventing one here would put a number in front of Google that appears
// nowhere on the page.
//
// No Review or AggregateRating either. The two anonymous testimonials this page
// used to carry were removed on 2026-09-13 and replaced with sourced statistics,
// so there is nothing on the page that a Review type could honestly describe.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'AI Readiness & AI Audits for Small Businesses',
      description:
        'A practical AI readiness assessment for small businesses. Where AI fits, where it does not, and what to do next.',
      dateModified,
      inLanguage: 'en-US',
      isPartOf: { '@type': 'WebSite', name: 'David J Forer', url: 'https://davidjforer.com' },
      primaryImageOfPage: 'https://davidjforer.com/images/ai-audit.webp',
      mainEntity: { '@id': `${pageUrl}#service` },
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'AI Readiness Audit',
      serviceType: 'AI readiness assessment',
      url: pageUrl,
      description:
        'A structured assessment of how ready a small business is to adopt AI, covering systems, workflows, data, documentation and team readiness, ending in a prioritised plan.',
      provider: {
        '@type': 'Person',
        '@id': 'https://davidjforer.com#david-j-forer',
        name: 'David J Forer',
        url: 'https://davidjforer.com',
        jobTitle: 'AI Operations Consultant',
      },
      areaServed: { '@type': 'Country', name: 'United States' },
      audience: {
        '@type': 'BusinessAudience',
        audienceType:
          'Founder-led service businesses between $1M and $5M in revenue with 5 to 20 staff and no operations lead',
      },
      // ItemList, not OfferCatalog. These are delivery phases, not things
      // anyone buys separately, and OfferCatalog would imply otherwise.
      subjectOf: {
        '@type': 'ItemList',
        '@id': `${pageUrl}#process`,
        name: 'AI Readiness Audit process',
        numberOfItems: phases.length,
        itemListOrder: 'https://schema.org/ItemListOrderAscending',
        itemListElement: phases.map((name, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name,
        })),
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://davidjforer.com' },
        { '@type': 'ListItem', position: 2, name: 'AI Readiness & AI Audits', item: pageUrl },
      ],
    },
  ],
};
---

<Layout 
title="AI Readiness & AI Audits for Small Businesses | Strategic Assessment"
description="A practical AI readiness assessment for small businesses. Where AI fits, where it does not, and what to do next."
image="/images/ai-audit.webp"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

	<body class="bg-white text-gray-800 font-sans">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 py-20">
        <div class="container mx-auto px-6 max-w-7xl">
            <div class="flex flex-col md:flex-row items-center justify-between gap-12">
                <div class="md:w-2/5 mb-10 md:mb-0">
                    <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">AI Readiness & AI Audits</h1>
                    <h2 class="text-xl md:text-2xl text-blue-100 mb-6">A practical assessment that shows where AI fits, where it does not, and what to do next</h2>
                    <p class="text-white text-lg mb-4">Most small businesses are already experimenting with AI. Very few know whether they are doing it well, safely, or consistently.</p>
                    <p class="text-white text-lg mb-8">An AI Readiness Audit helps you step back and assess how AI is actually being used across your business. The goal is not more tools. The goal is clarity, alignment, and a realistic path forward that supports your team instead of overwhelming it.</p>
                    <div>
                        <a href="#contact" class="bg-white text-blue-700 font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-blue-50 transition duration-300 inline-block">Schedule an AI Readiness Audit</a>
                    </div>
                </div>
                <div class="md:w-3/5 flex justify-center">
                    <div class="bg-white bg-opacity-20 backdrop-blur-sm p-4 rounded-xl shadow-xl">
                        <img src="../images/ai-audit.webp" alt="AI Readiness Audit" class="rounded-lg w-full h-auto">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Readiness Section -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6 max-w-5xl">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-blue-700 mb-4">Is Your Business Actually Ready for AI?</h2>
                <p class="text-xl text-gray-700 max-w-3xl mx-auto mb-6"><a href="/blog/ai-operations-for-small-businesses" class="text-blue-700 font-bold hover:underline">AI adoption</a> rarely fails because of technology. It fails because businesses skip the groundwork.</p>
                <p class="text-lg text-gray-600 max-w-3xl mx-auto mb-8">Without shared standards, clear priorities, and an understanding of <a href="/blog/intake-and-workflow-systems-for-growing-firms" class="text-blue-700 font-bold hover:underline">real workflows</a>, AI use becomes fragmented. One person experiments. Another avoids it. Leadership lacks visibility. Risk increases quietly.</p>
                <p class="text-lg text-gray-700 max-w-3xl mx-auto mb-8">The AI Readiness Audit is designed for small businesses around $1M in revenue that want to adopt AI deliberately, not reactively.</p>
            </div>
            
            <div class="bg-blue-50 p-8 rounded-lg shadow-md max-w-3xl mx-auto">
                <h3 class="text-xl font-bold text-gray-800 mb-4">This assessment helps you understand:</h3>
                <ul class="space-y-3 text-gray-700">
                    <li class="flex items-start">
                        <span class="text-blue-700 mr-3 mt-1">→</span>
                        <span>Where AI is already showing up in your business</span>
                    </li>
                    <li class="flex items-start">
                        <span class="text-blue-700 mr-3 mt-1">→</span>
                        <span>Where it creates leverage versus friction</span>
                    </li>
                    <li class="flex items-start">
                        <span class="text-blue-700 mr-3 mt-1">→</span>
                        <span>What needs to change before scaling usage across a team</span>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Pain Points Section -->
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-8 text-center">Common Signs You Need an AI Readiness Audit</h2>
            
            <div class="max-w-3xl mx-auto mb-8">
                <p class="text-lg text-gray-600 text-center">This audit exists to surface these issues before they become expensive.</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300 border-t-4 border-red-500">
                    <div class="text-red-500 text-3xl mb-4">⚠️</div>
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Disorganized Systems and Workflows</h3>
                    <p class="text-gray-600">AI is layered on top of <a href="/blog/ai-powered-back-office-design-guide" class="text-blue-700 font-bold hover:underline">already messy processes</a>, creating more complexity instead of efficiency.</p>
                </div>
                
                <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300 border-t-4 border-red-500">
                    <div class="text-red-500 text-3xl mb-4">📋</div>
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Missing or Inconsistent SOPs</h3>
                    <p class="text-gray-600">Work lives in people's heads, making it difficult to standardize AI usage or <a href="/blog/ai-training-team-adoption-small-business" class="text-blue-700 font-bold hover:underline">train others effectively</a>.</p>
                </div>
                
                <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300 border-t-4 border-red-500">
                    <div class="text-red-500 text-3xl mb-4">❓</div>
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Unclear Communication and Ownership</h3>
                    <p class="text-gray-600">No one knows who is using AI, how it is being used, or what "good" looks like across the team.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Section -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-8 text-center">Our AI Readiness Audit Process</h2>
            
            <div class="max-w-3xl mx-auto text-center mb-12">
                <p class="text-lg text-gray-700">The audit is designed to be thorough without being disruptive. It focuses on understanding how work actually happens before making recommendations.</p>
            </div>
            
            <div class="space-y-12">
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">1</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Preparation and Context</h3>
                        <p class="text-gray-600 mb-4">We gather background on your business, goals, <a href="/blog/ai-tools-tech-stack-small-business" class="text-blue-700 font-bold hover:underline">tools</a>, and constraints to ensure the audit reflects reality, not theory.</p>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Timeline:</strong> Days 0-1</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">2</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Interviews and Discovery</h3>
                        <p class="text-gray-600 mb-4">We speak with leadership and key team members to identify pain points, current AI usage, and areas of friction.</p>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Timeline:</strong> Days 1-2</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">3</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Readiness Analysis</h3>
                        <p class="text-gray-600 mb-4">We assess <a href="/blog/ai-readiness-framework-for-service-businesses" class="text-blue-700 font-bold hover:underline">AI maturity</a> across workflows, skills, risk exposure, and operational structure to identify where AI will help or hurt.</p>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Timeline:</strong> Days 3-4</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">4</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Findings and Synthesis</h3>
                        <p class="text-gray-600 mb-4">We consolidate insights into a clear picture of readiness, gaps, and opportunities.</p>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Timeline:</strong> Days 4-5</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">5</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Delivery and Next-Step Planning</h3>
                        <p class="text-gray-600 mb-4">You receive a structured report and <a href="/blog/working-with-an-ai-consultant" class="text-blue-700 font-bold hover:underline">a review call</a> to walk through findings and outline practical next steps.</p>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Timeline:</strong> Days 5-7</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- What You Get Section -->
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-16 text-center">What the AI Readiness Audit Delivers</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                <div class="bg-white p-8 rounded-lg shadow-md">
                    <h3 class="text-2xl font-bold text-gray-800 mb-6">Strategic Clarity</h3>
                    
                    <ul class="space-y-4">
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>AI readiness assessment across key operational dimensions</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>Visibility into current AI usage and hidden risk</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>Clear prioritization of where AI should be applied first</span>
                        </li>
                    </ul>
                </div>
                
                <div class="bg-white p-8 rounded-lg shadow-md">
                    <h3 class="text-2xl font-bold text-gray-800 mb-6">Practical Direction</h3>
                    
                    <ul class="space-y-4">
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>3 to 6 high-impact opportunities grounded in your workflows</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>A <a href="/blog/ai-strategy-for-small-businesses" class="text-blue-700 font-bold hover:underline">phased roadmap</a> that balances quick wins with long-term capability</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>Guidance on whether training, process changes, or <a href="/blog/automation-architecture-for-small-teams" class="text-blue-700 font-bold hover:underline">automation</a> should come next</span>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="mt-12 text-center max-w-3xl mx-auto">
                <p class="text-lg text-gray-700">Many clients use the audit to determine whether AI training is needed, which teams should be trained first, and what standards must be in place before scaling usage.</p>
            </div>
        </div>
    </section>

    <!-- Results Section -->
    <section class="py-16 bg-gray-900 text-white">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-400 mb-8 text-center">What Businesses Gain From an AI Readiness Audit</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div class="bg-gray-800 p-6 rounded-lg">
                    <div class="flex items-start">
                        <span class="text-blue-400 mr-4 text-2xl">✓</span>
                        <p class="text-gray-200">Reduced rework and inefficiency caused by fragmented AI use</p>
                    </div>
                </div>
                
                <div class="bg-gray-800 p-6 rounded-lg">
                    <div class="flex items-start">
                        <span class="text-blue-400 mr-4 text-2xl">✓</span>
                        <p class="text-gray-200">Better decision-making around tools and initiatives</p>
                    </div>
                </div>
                
                <div class="bg-gray-800 p-6 rounded-lg">
                    <div class="flex items-start">
                        <span class="text-blue-400 mr-4 text-2xl">✓</span>
                        <p class="text-gray-200">Clear expectations for how AI should support the team</p>
                    </div>
                </div>
                
                <div class="bg-gray-800 p-6 rounded-lg">
                    <div class="flex items-start">
                        <span class="text-blue-400 mr-4 text-2xl">✓</span>
                        <p class="text-gray-200">A foundation for effective AI training and adoption</p>
                    </div>
                </div>
                
                <div class="bg-gray-800 p-6 rounded-lg md:col-span-2">
                    <div class="flex items-start justify-center">
                        <span class="text-blue-400 mr-4 text-2xl">✓</span>
                        <p class="text-gray-200">Confidence to move forward without guesswork</p>
                    </div>
                </div>
            </div>
            
            <div class="text-center">
                <p class="text-xl text-blue-400 font-semibold">This audit is about reducing uncertainty, not chasing trends.</p>
            </div>
        </div>
    </section>

    <!-- Training Connection Section -->
    <section class="py-16 bg-blue-50">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-8 text-center">How AI Readiness Audits and AI Training Work Together</h2>
            
            <div class="max-w-3xl mx-auto">
                <p class="text-xl text-gray-700 mb-6">AI training is most effective when it is informed by context.</p>
                
                <p class="text-lg text-gray-600 mb-6">The AI Readiness Audit helps determine:</p>
                
                <ul class="space-y-3 text-gray-700 mb-8">
                    <li class="flex items-start">
                        <span class="text-blue-700 mr-3 mt-1">→</span>
                        <span>Which teams actually need training</span>
                    </li>
                    <li class="flex items-start">
                        <span class="text-blue-700 mr-3 mt-1">→</span>
                        <span>What skills matter most for your business</span>
                    </li>
                    <li class="flex items-start">
                        <span class="text-blue-700 mr-3 mt-1">→</span>
                        <span>Where guardrails are required before scaling usage</span>
                    </li>
                </ul>
                
                <p class="text-lg text-gray-700 mb-8">Some clients start with training. Many start with an audit. Both paths work, but clarity always comes first.</p>
                
                <div class="text-center">
                    <a href="/ai-training-for-small-business-teams" class="inline-block bg-blue-700 text-white font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-blue-800 transition duration-300">Explore AI Training for Small Business Teams</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Where the numbers come from -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-4 text-center">Where AI Readiness Numbers Come From</h2>
            <p class="text-lg text-gray-700 mb-12 text-center max-w-3xl mx-auto">Four numbers worth knowing before you buy any assessment, this one included.</p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="bg-gray-50 p-6 rounded-lg shadow-md border-l-4 border-blue-700">
                    <p class="text-4xl font-bold text-blue-700 mb-3">13%</p>
                    <p class="text-gray-700 mb-4">of companies are rated fully ready for AI in Cisco's AI Readiness Index. All 8,039 leaders surveyed work at companies with 500 or more employees, and the figure has moved 14, 13, 13 across three years.</p>
                    <p class="text-sm text-gray-500">Cisco AI Readiness Index, 2023 to 2025</p>
                </div>

                <div class="bg-gray-50 p-6 rounded-lg shadow-md border-l-4 border-blue-700">
                    <p class="text-4xl font-bold text-blue-700 mb-3">$500M</p>
                    <p class="text-gray-700 mb-4">is where Deloitte's definition of a smaller firm begins, and it runs to $5 billion. McKinsey weights its results by national GDP, and 38 percent of its respondents work at companies above $1 billion. The benchmarks a 12-person business gets compared against contain no business its size.</p>
                    <p class="text-sm text-gray-500">Deloitte Insights 2025, McKinsey State of AI 2025</p>
                </div>

                <div class="bg-gray-50 p-6 rounded-lg shadow-md border-l-4 border-blue-700">
                    <p class="text-4xl font-bold text-blue-700 mb-3">79%</p>
                    <p class="text-gray-700 mb-4">of 8,000 firms rated their own management practices above average. When double-blind interviewers scored the same firms, the two sets of scores showed no correlation. Self-scoring is the input to almost every readiness number on the market.</p>
                    <p class="text-sm text-gray-500">Bloom, Sadun and Van Reenen, World Management Survey</p>
                </div>

                <div class="bg-gray-50 p-6 rounded-lg shadow-md border-l-4 border-blue-700">
                    <p class="text-4xl font-bold text-blue-700 mb-3">0 of 13</p>
                    <p class="text-gray-700 mb-4">free AI readiness scorecards from Microsoft, Google, AWS, HubSpot, IBM, EY and SAP produce a written process document. They run 8 to 45 questions, and every one of them ends at a product recommendation or a sales call.</p>
                    <p class="text-sm text-gray-500">Catalogued September 2026</p>
                </div>
            </div>

            <div class="mt-12 max-w-3xl mx-auto">
                <p class="text-lg text-gray-700">Ask two questions about any AI assessment before you pay for it. Who checks the answer, and what does it leave behind. A 12-person company has no regulator and no procurement office reading the result, so the report itself is the whole product. This one leaves process maps of the workflows it examines, a baseline measured before anything changes so you can tell later whether it worked, 3 to 6 opportunities grounded in those same workflows, and a review call to walk through them.</p>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-12 text-center">Frequently Asked Questions</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
                <div>
