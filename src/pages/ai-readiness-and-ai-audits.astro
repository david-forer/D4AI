---
import Layout from '../layouts/Layout.astro';
import FormSection from '../components/FormSection.astro';
import { AI_AUDIT_SURVEY, AI_AUDIT_FIELDS } from '../lib/leadForms';

const pageUrl = 'https://davidjforer.com/ai-readiness-and-ai-audits';

// Bump when the page content materially changes. A dateModified that never
// moves is worse than none.
const dateModified = '2026-09-12';

// Mirrors the visible FAQ section verbatim. Google requires the marked-up
// answer to match what a visitor actually reads, so edit both or neither.
const faqs = [
  {
    q: 'How long does the AI Audit take?',
    a: 'The complete audit process takes approximately 5-7 days from kickoff to final delivery, including interviews, analysis, and report creation.',
  },
  {
    q: 'Do I need technical knowledge about AI?',
    a: 'No technical knowledge is required. We explain everything in business terms and provide guidance on implementation regardless of your technical background.',
  },
  {
    q: 'Will this disrupt our current operations?',
    a: 'The audit takes only 1-2 hours of your time, for interviews. Implementation follows a phased approach you control.',
  },
  {
    q: 'Is my business too small for AI?',
    a: 'Not at all. Our AI Audit is specifically designed for small businesses around $1M in revenue who want to scale without adding headcount.',
  },
  {
    q: "What if we've never used AI before?",
    a: 'That is often the best starting point. The audit will identify the best entry points for AI in your business and provide a step-by-step implementation plan to get started.',
  },
  {
    q: 'Do you help with implementation?',
    a: 'Yes. We provide implementation planning as part of the audit, and we offer additional implementation services if you need hands-on assistance.',
  },
];

// The five delivery phases, taken from the visible "Our AI Readiness Audit
// Process" section.
const phases = [
  'Preparation and Context',
  'Interviews and Discovery',
  'Readiness Analysis',
  'Findings and Synthesis',
  'Delivery and Next-Step Planning',
];

// Prices are published on this page as of 2026-09-17, in the #pricing section.
// The private offer file is the source of truth for every number here. No `offers`
// schema block yet: adding one means committing to keeping structured data in
// sync with the visible table, and a stale price in schema is worse than none.
// Revisit once the prices have held steady for a quarter.
//
// No Review or AggregateRating either. The two anonymous testimonials this page
// used to carry were removed on 2026-09-13 and replaced with sourced statistics,
// so there is nothing on the page that a Review type could honestly describe.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'AI Readiness & AI Audits for Small Businesses',
      description:
        'A practical AI readiness assessment for small businesses. Where AI fits, where it does not, and what to do next.',
      dateModified,
      inLanguage: 'en-US',
      isPartOf: { '@type': 'WebSite', name: 'David J Forer', url: 'https://davidjforer.com' },
      primaryImageOfPage: 'https://davidjforer.com/images/ai-audit.webp',
      mainEntity: { '@id': `${pageUrl}#service` },
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'AI Readiness Audit',
      serviceType: 'AI readiness assessment',
      url: pageUrl,
      description:
        'A structured assessment of how ready a small business is to adopt AI, covering systems, workflows, data, documentation and team readiness, ending in a prioritised plan.',
      provider: {
        '@type': 'Person',
        '@id': 'https://davidjforer.com#david-j-forer',
        name: 'David J Forer',
        url: 'https://davidjforer.com',
        jobTitle: 'AI Operations Consultant',
      },
      areaServed: { '@type': 'Country', name: 'United States' },
      audience: {
        '@type': 'BusinessAudience',
        audienceType:
          'Founder-led service businesses between $1M and $5M in revenue with 5 to 20 staff and no operations lead',
      },
      // ItemList, not OfferCatalog. These are delivery phases, not things
      // anyone buys separately, and OfferCatalog would imply otherwise.
      subjectOf: {
        '@type': 'ItemList',
        '@id': `${pageUrl}#process`,
        name: 'AI Readiness Audit process',
        numberOfItems: phases.length,
        itemListOrder: 'https://schema.org/ItemListOrderAscending',
        itemListElement: phases.map((name, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name,
        })),
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://davidjforer.com' },
        { '@type': 'ListItem', position: 2, name: 'AI Readiness & AI Audits', item: pageUrl },
      ],
    },
  ],
};
---

<Layout 
title="AI Readiness & AI Audits for Small Businesses | Strategic Assessment"
description="A practical AI readiness assessment for small businesses. Where AI fits, where it does not, and what to do next."
image="/images/ai-audit.webp"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

	<body class="bg-white text-gray-800 font-sans">
    {/* Hero Section */}
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 py-20 relative overflow-hidden">
        {/* Background texture. Concentric rings, an assessment motif rather than a solid shape. Decorative only. */}
        <div class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true">
            <div class="absolute top-16 left-16 w-48 h-48 rounded-full border-[14px] border-cyan-200"></div>
            <div class="absolute bottom-12 right-24 w-64 h-64 rounded-full border-[20px] border-blue-200"></div>
            <div class="absolute top-1/2 left-1/2 w-24 h-24 rounded-full border-[10px] border-sky-100"></div>
        </div>
        <div class="container mx-auto px-6 max-w-6xl relative z-10">
            <div class="text-center">
                <div>
                    <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">AI Readiness & AI Audits</h1>
                    <h2 class="text-xl md:text-2xl text-blue-100 mb-6">A practical assessment that shows where AI fits, where it does not, and what to do next</h2>
                    <p class="text-white text-lg mb-4">Most small businesses are already experimenting with AI. Very few know whether they are doing it safely.</p>
                    <p class="text-white text-lg mb-8">An AI Readiness Audit shows you how AI is actually being used across your business. You come out with a shared picture of where you stand and a realistic plan your team can carry out.</p>
                    <div>
                        <a href="#pricing" class="bg-white text-blue-700 font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-blue-50 transition duration-300 inline-block">See audit options and pricing</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {/* Readiness Section */}
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6 max-w-5xl">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-blue-700 mb-4">Is Your Business Actually Ready for AI?</h2>
                <p class="text-xl text-gray-700 max-w-3xl mx-auto mb-6"><a href="/blog/ai-operations-for-small-businesses" class="text-blue-700 font-bold hover:underline">AI adoption</a> rarely fails because of technology. It fails because businesses skip the groundwork.</p>
                <p class="text-lg text-gray-600 max-w-3xl mx-auto mb-8">Without shared standards, clear priorities, and an understanding of <a href="/blog/intake-and-workflow-systems-for-growing-firms" class="text-blue-700 font-bold hover:underline">real workflows</a>, AI use becomes fragmented. One person experiments while another avoids it, and leadership can't see either. Risk builds quietly.</p>
                <p class="text-lg text-gray-700 max-w-3xl mx-auto mb-8">The AI Readiness Audit is designed for small businesses around $1M in revenue that want to adopt AI deliberately, not reactively.</p>
            </div>
            
            <div class="bg-blue-50 p-8 rounded-lg shadow-md max-w-3xl mx-auto">
                <h3 class="text-xl font-bold text-gray-800 mb-4">This assessment helps you understand:</h3>
                <ul class="space-y-3 text-gray-700">
                    <li class="flex items-start">
                        <span class="text-blue-700 mr-3 mt-1">→</span>
                        <span>Where AI is already showing up in your business</span>
                    </li>
                    <li class="flex items-start">
                        <span class="text-blue-700 mr-3 mt-1">→</span>
                        <span>Where it saves time and where it adds friction</span>
                    </li>
                    <li class="flex items-start">
                        <span class="text-blue-700 mr-3 mt-1">→</span>
                        <span>What needs to change before scaling usage across a team</span>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    {/* Pain Points Section */}
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-8 text-center">Common Signs You Need an AI Readiness Audit</h2>
            
            <div class="max-w-3xl mx-auto mb-8">
                <p class="text-lg text-gray-600 text-center">This audit exists to surface these issues before they become expensive.</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300 border-t-4 border-red-500">
                    <div class="text-red-500 text-3xl mb-4">⚠️</div>
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Disorganized Systems and Workflows</h3>
                    <p class="text-gray-600">AI gets layered on top of <a href="/blog/ai-powered-back-office-design-guide" class="text-blue-700 font-bold hover:underline">already messy processes</a>, and the result is more complexity.</p>
                </div>
                
                <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300 border-t-4 border-red-500">
                    <div class="text-red-500 text-3xl mb-4">📋</div>
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Missing or Inconsistent SOPs</h3>
                    <p class="text-gray-600">Work lives in people's heads, making it difficult to standardize AI usage or <a href="/blog/ai-training-team-adoption-small-business" class="text-blue-700 font-bold hover:underline">train others effectively</a>.</p>
                </div>
                
                <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300 border-t-4 border-red-500">
                    <div class="text-red-500 text-3xl mb-4">❓</div>
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Unclear Communication and Ownership</h3>
                    <p class="text-gray-600">No one knows who is using AI, how it is being used, or what "good" looks like across the team.</p>
                </div>
            </div>
        </div>
    </section>

    {/* Process Section */}
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-8 text-center">Our AI Readiness Audit Process</h2>
            
            <div class="max-w-3xl mx-auto text-center mb-12">
                <p class="text-lg text-gray-700">The audit is thorough and light on your team's time. It looks at how work actually happens before making any recommendation.</p>
            </div>
            
            <div class="space-y-12">
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">1</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Preparation and Context</h3>
                        <p class="text-gray-600 mb-4">We gather background on your business, goals, <a href="/blog/ai-tools-tech-stack-small-business" class="text-blue-700 font-bold hover:underline">tools</a>, and constraints to ensure the audit reflects reality, not theory.</p>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Timeline:</strong> Days 0-1</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">2</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Interviews and Discovery</h3>
                        <p class="text-gray-600 mb-4">We speak with leadership and key team members to find where the friction is and how AI is being used today.</p>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Timeline:</strong> Days 1-2</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">3</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Readiness Analysis</h3>
                        <p class="text-gray-600 mb-4">We assess <a href="/blog/ai-readiness-framework-for-service-businesses" class="text-blue-700 font-bold hover:underline">AI maturity</a> across workflows, skills, risk exposure, and operational structure to identify where AI will help or hurt.</p>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Timeline:</strong> Days 3-4</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">4</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Findings and Synthesis</h3>
                        <p class="text-gray-600 mb-4">We turn what we learned into a clear picture of where you are ready and where the gaps are.</p>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Timeline:</strong> Days 4-5</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">5</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Delivery and Next-Step Planning</h3>
                        <p class="text-gray-600 mb-4">You receive a structured report and <a href="/blog/working-with-an-ai-consultant" class="text-blue-700 font-bold hover:underline">a review call</a> to walk through findings and outline practical next steps.</p>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Timeline:</strong> Days 5-7</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {/* What You Get Section */}
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-16 text-center">What the AI Readiness Audit Delivers</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                <div class="bg-white p-8 rounded-lg shadow-md">
                    <h3 class="text-2xl font-bold text-gray-800 mb-6">Strategic Clarity</h3>
                    
                    <ul class="space-y-4">
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>AI readiness assessment across key operational dimensions</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>Visibility into current AI usage and hidden risk</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>Clear prioritization of where AI should be applied first</span>
                        </li>
                    </ul>
                </div>
                
                <div class="bg-white p-8 rounded-lg shadow-md">
                    <h3 class="text-2xl font-bold text-gray-800 mb-6">Practical Direction</h3>
                    
                    <ul class="space-y-4">
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>3 to 6 high-impact opportunities grounded in your workflows</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>A <a href="/blog/ai-strategy-for-small-businesses" class="text-blue-700 font-bold hover:underline">phased roadmap</a> that balances quick wins with long-term capability</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-700 mr-3 mt-1">✓</span>
                            <span>Guidance on whether training, process changes, or <a href="/blog/automation-architecture-for-small-teams" class="text-blue-700 font-bold hover:underline">automation</a> should come next</span>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="mt-12 text-center max-w-3xl mx-auto">
                <p class="text-lg text-gray-700">Many clients use the audit to determine whether AI training is needed, which teams should be trained first, and what standards must be in place before scaling usage.</p>
            </div>
        </div>
    </section>

    {/* Pricing. Added 2026-09-17. Do not change a number here without changing
         it in the private offer file first. Install prices are a range on purpose.
         Scope comes out of the audit, never out of a discovery call. */}
    <section id="pricing" class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 max-w-6xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-4 text-center">What an Audit Costs</h2>
            <p class="text-lg text-gray-700 mb-12 text-center max-w-3xl mx-auto">
                Fixed price, agreed in writing before anything starts. No retainer, no hourly billing,
                no scope that grows while you are not looking.
            </p>

            <div class="grid md:grid-cols-3 gap-8 mb-12">
                <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-200 flex flex-col">
                    <p class="uppercase text-xs tracking-wider font-medium text-blue-600 mb-3">Start here</p>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">80/20 Process Audit</h3>
                    <p class="text-4xl font-extrabold text-blue-700 mb-1">$750</p>
                    <p class="text-sm text-gray-500 mb-6">2 to 3 hours with you. Delivered same day or next day.</p>
                    <ul class="text-gray-700 space-y-3 flex-1">
                        <li class="flex items-start"><span class="text-blue-700 mr-3">✓</span><span>Your top 3 processes captured as inputs, rules and outputs</span></li>
                        <li class="flex items-start"><span class="text-blue-700 mr-3">✓</span><span>Top 5 automation opportunities with the ROI maths behind each</span></li>
                        <li class="flex items-start"><span class="text-blue-700 mr-3">✓</span><span>A one page opportunity report plus the 3 process sketches, yours to keep</span></li>
                    </ul>
                    <p class="text-sm text-gray-500 mt-6 pt-4 border-t border-gray-100">Paid in full upfront</p>
                </div>

                <div class="bg-white rounded-xl p-8 shadow-md border-2 border-blue-600 flex flex-col">
                    <p class="uppercase text-xs tracking-wider font-medium text-blue-600 mb-3">Most common</p>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Quick Assessment</h3>
                    <p class="text-4xl font-extrabold text-blue-700 mb-1">$1,500</p>
                    <p class="text-sm text-gray-500 mb-6">4 to 6 hours of interviews. One week start to finish.</p>
                    <ul class="text-gray-700 space-y-3 flex-1">
                        <li class="flex items-start"><span class="text-blue-700 mr-3">✓</span><span>You and one key person interviewed, 5 to 6 core processes documented</span></li>
                        <li class="flex items-start"><span class="text-blue-700 mr-3">✓</span><span>System review including whether your tools will actually let data out</span></li>
                        <li class="flex items-start"><span class="text-blue-700 mr-3">✓</span><span>SOP pack, ranked opportunity cost table, and a roadmap built for your business</span></li>
                    </ul>
                    <p class="text-sm text-gray-500 mt-6 pt-4 border-t border-gray-100">50% upfront, 50% on delivery</p>
                </div>

                <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-200 flex flex-col">
                    <p class="uppercase text-xs tracking-wider font-medium text-blue-600 mb-3">Full picture</p>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Full AI Operations Audit</h3>
                    <p class="text-4xl font-extrabold text-blue-700 mb-1">$4,000</p>
                    <p class="text-sm text-gray-500 mb-6">8 to 15 hours of interviews. Two weeks start to finish.</p>
                    <ul class="text-gray-700 space-y-3 flex-1">
                        <li class="flex items-start"><span class="text-blue-700 mr-3">✓</span><span>Owner, department heads and key staff, following the customer journey from first contact to invoice</span></li>
                        <li class="flex items-start"><span class="text-blue-700 mr-3">✓</span><span>Full process library, evidence linked findings, and opportunity cost ranked in dollars</span></li>
                        <li class="flex items-start"><span class="text-blue-700 mr-3">✓</span><span>One working automation built and shipped live during the audit week</span></li>
                    </ul>
                    <p class="text-sm text-gray-500 mt-6 pt-4 border-t border-gray-100">50% upfront, 50% on delivery</p>
                </div>
            </div>

            <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-200 mb-8">
                <h3 class="text-xl font-bold text-gray-800 mb-6">Add-ons</h3>
                <div class="grid md:grid-cols-2 gap-8">
                    <div>
                        <div class="flex items-baseline gap-3 mb-2">
                            <h4 class="text-lg font-semibold text-gray-800">AI Training</h4>
                            <span class="text-2xl font-extrabold text-blue-700">$1,500</span>
                        </div>
                        <p class="text-gray-700">Role based training for your team, delivered remotely. Live workshops, hands on workflow sessions, and follow up so it sticks after the enthusiasm fades. Often the right first step when a full build feels too big.</p>
                    </div>
                    <div>
                        <div class="flex items-baseline gap-3 mb-2">
                            <h4 class="text-lg font-semibold text-gray-800">SEO Operations</h4>
                            <span class="text-2xl font-extrabold text-blue-700">$2,500</span>
                        </div>
                        <p class="text-gray-700">Technical audit, semantic keyword research and content optimisation, run as an operations problem rather than a marketing retainer. Worth adding only if the audit shows visibility is genuinely what is holding you back.</p>
                    </div>
                </div>
            </div>

            <div class="bg-blue-700 rounded-xl p-8 text-white">
                <h3 class="text-xl font-bold mb-3">If you want the work done as well</h3>
                <p class="text-blue-50 mb-4">
                    Builds run from <span class="font-bold text-white">$7,500 to $15,000</span> depending on how many
                    processes are in scope, and take 3 to 12 weeks. Fixed price, named in writing before anything starts.
                </p>
                <p class="text-blue-50">
                    A build is always quoted after an audit, never before. Scoping a build without looking at how your
                    business actually runs is guessing, and you would be paying for the guess.
                </p>
            </div>

            <div class="mt-12 text-center">
                <a href="https://calendly.com/david-j-forer/30min" class="bg-blue-700 text-white font-bold py-4 px-10 rounded-lg shadow-lg hover:bg-blue-800 transition duration-300 inline-block">Book a 30 minute call</a>
                <p class="text-sm text-gray-600 mt-4">No pitch. I will tell you which tier fits, or that none of them do.</p>
            </div>
