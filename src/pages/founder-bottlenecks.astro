    }
    
    .toc-link {
      display: block;
      padding: 0.5rem 0;
      color: var(--neutral);
      text-decoration: none;
      border-left: 2px solid transparent;
      padding-left: 1rem;
      transition: all 0.2s ease;
    }
    
    .toc-link:hover, .toc-link.active {
