                      <th class="text-left py-4 px-6 font-semibold text-gray-900">Key Focus</th>
                      <th class="text-left py-4 px-6 font-semibold text-gray-900">Methods/Tools</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="border-b border-gray-100 hover:bg-gray-50">
                      <td class="py-4 px-6 font-semibold text-teal-700">Founder Involvement & Workload</td>
