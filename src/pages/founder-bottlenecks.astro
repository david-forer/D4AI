          <!-- Diagnostic Framework Table -->
          <div class="data-viz-container mb-12">
            <div class="p-8">
              <h3 class="text-2xl font-light text-gray-900 mb-6">Comprehensive Diagnostic Framework</h3>
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead>
                    <tr class="border-b-2 border-gray-200">
