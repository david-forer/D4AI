      border-left-color: var(--accent);
      background-color: var(--secondary);
    }
    
    .section-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, var(--accent) 50%, transparent 100%);
      margin: 3rem 0;
    }
    
    .insight-highlight {
      background: linear-gradient(135deg, var(--secondary) 0%, rgba(240, 253, 250, 0.5) 100%);
      border-left: 4px solid var(--accent);
    }
    
    .data-viz-container {
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      overflow: hidden;
    }
    
    /* Numbered vertical stepper. Replaces the old Mermaid flow SVG so the
       content is real, indexable, responsive text instead of a fixed-width image. */
    .diagram-steps {
      list-style: none;
      margin: 2.5rem 0 2.5rem 1rem;
      padding: 0;
      border-left: 2px solid #dbeafe;
    }

    .diagram-steps li {
      position: relative;
      padding: 0 0 2rem 2.5rem;
    }

    .diagram-steps li:last-child {
      padding-bottom: 0;
    }

    .diagram-step-num {
      position: absolute;
      left: -1.0625rem;
      top: 0;
      width: 2rem;
      height: 2rem;
      border-radius: 9999px;
      background: var(--primary);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .diagram-steps h4 {
      font-size: 1.125rem;
      font-weight: 600;
      color: #111827;
      margin: 0.25rem 0 0.375rem;
    }

    .diagram-steps p {
      color: #4b5563;
      margin: 0;
      line-height: 1.6;
    }

    .diagram-steps li.is-finding .diagram-step-num {
      background: var(--accent);
      box-shadow: 0 0 0 4px var(--secondary);
    }

    .go-deeper {
      list-style: none;
      margin: 0;
      padding: 0;
      columns: 2;
      column-gap: 2.5rem;
    }

    .go-deeper li {
      break-inside: avoid;
      margin-bottom: 0.625rem;
    }

    .go-deeper a {
      color: var(--primary);
      text-decoration: none;
      border-bottom: 1px solid #dbeafe;
      transition: border-color 0.2s ease;
    }

    .go-deeper a:hover {
      border-bottom-color: var(--primary);
    }

    @media (max-width: 640px) {
      .go-deeper { columns: 1; }
    }

    /* Four-phase timeline. Replaces the old Mermaid timeline SVG. */
    .diagram-phases {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 1.25rem;
      margin: 2.5rem 0;
      list-style: none;
      padding: 0;
    }

    .diagram-phases > li {
      border: 1px solid #e5e7eb;
      border-top: 3px solid var(--accent);
      border-radius: 12px;
      padding: 1.5rem;
      background: #ffffff;
    }

    .diagram-phase-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.5rem;
    }

    .diagram-phases h4 {
      font-size: 1.0625rem;
      font-weight: 600;
      color: #111827;
      margin: 0 0 0.875rem;
    }

    .diagram-phases ul {
      list-style: disc;
      margin: 0;
      padding-left: 1.125rem;
      color: #4b5563;
    }

    .diagram-phases ul li {
      margin-bottom: 0.4rem;
      line-height: 1.5;
    }

    /* Linear pipeline. Replaces the 1512px-wide Mermaid SVG that was being
       clipped by the page's overflow-x-hidden. */
    .diagram-pipeline {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 0.75rem;
      margin: 2.5rem 0;
      list-style: none;
      padding: 0;
      counter-reset: pipe;
    }

    .diagram-pipeline li {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 1rem;
      background: var(--base);
    }

    .diagram-pipeline li.needs-founder {
      border-color: var(--accent);
      background: var(--secondary);
    }

    .diagram-pipeline h4 {
      font-size: 0.9375rem;
      font-weight: 600;
      color: #111827;
      margin: 0 0 0.25rem;
    }

    .diagram-pipeline p {
      font-size: 0.8125rem;
      color: #6b7280;
      margin: 0;
      line-height: 1.45;
    }

    .diagram-pipeline .flag {
      display: inline-block;
      margin-top: 0.5rem;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--primary);
    }

    @media (max-width: 1024px) {
      .toc-fixed {
        transform: translateX(-100%);
        transition: transform 0.3s ease;
      }
      
      .toc-fixed.open {
        transform: translateX(0);
      }
      
      .main-content {
        margin-left: 0;
      }

    }

    @media (max-width: 768px) {
      .hero-gradient {
        padding: 2rem;
      }
      .hero-gradient h1 {
        font-size: 1.8rem;
        line-height: 1.2;
      }
      .hero-gradient p {
        font-size: 1rem;
      }
    }

    /* Footer alignment for sidebar layout */
    :global(footer) {
      margin-left: 280px;
    }

    @media (max-width: 1024px) {
      :global(footer) {
        margin-left: 0;
      }
    }
  </style>

  <!-- FontAwesome loaded non-blocking. The 49 icons on this page are decorative,
       so a late paint is preferable to blocking first render on a CDN round trip. -->
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></noscript>

  <div class="bg-gray-50 overflow-x-hidden">
    <!-- Fixed Table of Contents -->
    <nav class="toc-fixed" id="toc">
      <div class="mb-8">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Contents</h3>
        <div class="space-y-1">
          <a href="#hero" class="toc-link text-sm">Executive Summary</a>
          <a href="#understanding" class="toc-link text-sm">Understanding Founder Bottlenecks</a>
