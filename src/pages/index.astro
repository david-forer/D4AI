---
// src/pages/index.astro - Homepage. AI operations consulting.
// SEO removed from this page entirely on 2026-09-17. It is a $2,500 add-on,
// not the offer, and leading with it was pulling the wrong buyer.
//
// Design pass 2026-10-07: navy and paper with burnt orange, one typeface
// (Bricolage Grotesque, set site-wide in Layout.astro). The calculator is a
// receipt in Hero.astro and it is the only copy of that math. This page owns
// the colour tokens on .fs. Other pages keep their own look for now.
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import CaseStudyProof from '../components/CaseStudyProof.astro';
import { GIVEAWAY_SURVEY, GIVEAWAY_FIELDS } from '../lib/leadForms';
import { getCollection } from 'astro:content';

// Proof section. This replaced a "What Experts Say" block on 2026-09-17 that
// carried unsourced quotes attributed to Jason Calacanis, Mark Cuban and Dario
// Amodei under five-star review icons. None could be traced to a published
// source. Do not reinstate quotes from named people without a link to where
// they actually said it. The correct pattern is on /fix-the-chaos, which names
// the publication and states plainly that those people are not clients.
const featuredBuilds = (await getCollection('builds', ({ data }) =>
  data.featured === true && data.status !== 'archived'
)).slice(0, 3);

const BOOKING = 'https://calendly.com/david-j-forer/30min';

const audits = [
  {
    badge: 'Start here',
    name: '80/20 Process Audit',
    price: '$750',
    time: '2 to 3 hours with you. Delivered same day or next day.',
    points: [
      'Your top 3 processes captured as inputs, rules and outputs',
      'Top 5 automation opportunities with the ROI math behind each',
      'A one page opportunity report plus the 3 process sketches, yours to keep',
    ],
    cta: 'Book this audit',
    pick: false,
  },
  {
    badge: 'Most common',
    name: 'Quick Assessment',
    price: '$1,500',
    time: '4 to 6 hours of interviews. One week start to finish.',
    points: [
      'You and one key person interviewed, 5 to 6 core processes documented',
      'System review including whether your tools will actually let data out',
      'SOP pack, ranked opportunity cost table, and a roadmap built for your business',
    ],
    cta: 'Book this assessment',
    pick: true,
  },
  {
    badge: 'Full picture',
    name: 'Full AI Operations Audit',
    price: '$4,000',
    time: '8 to 15 hours of interviews. Two weeks start to finish.',
    points: [
      'Owner, department heads and key staff, following the customer journey from first contact to invoice',
      'Full process library, evidence linked findings, and opportunity cost ranked in dollars',
      'One working automation built and shipped live during the audit week',
    ],
    cta: 'Book the full audit',
    pick: false,
  },
];

const deliverables = [
  { title: 'A map of how the work runs', body: 'Process maps and plain English SOPs, written from interviews with you and your team.' },
  { title: 'Findings tied to evidence', body: 'Every finding points to where it showed up, so you can check it yourself.' },
  { title: 'Costs ranked in dollars', body: 'Each opportunity priced per year, including the hours the business waits on you.' },
  { title: 'An AI roadmap', body: 'Which of your current tools can connect, and the first builds named. On the full audit, one ships live that week.' },
];

const steps = [
  { title: 'Map how the work runs', hot: false },
  { title: 'Put a number on the cost', hot: false },
  { title: 'Find where work waits on you', hot: true, note: 'The number from the top of this page' },
  { title: 'Build the automations', hot: false },
  { title: 'Write it down', hot: false },
  { title: 'Train the team', hot: false },
];

const faqs = [
  {
    q: 'Do I have to buy implementation?',
    a: 'No. The audit stands alone. You keep the process maps, SOPs and roadmap, and any developer or team can build from them. Implementation is quoted only after the audit, at a fixed scope, so you decide with the real findings in hand instead of a guess.',
  },
  {
    q: 'How much of my time does it take?',
    a: 'The $750 audit takes two to three hours with you and nobody else. The full audit runs eight to fifteen hours of interviews across you, your leads and key staff, so one person on your side coordinates the schedule and tool access. I handle everything else.',
  },
  {
    q: 'Which tools will you push?',
    a: 'I start with what you already pay for. For each tool I check whether it has an API, an MCP connection or an export path, because a recommendation that cannot connect to your stack is a guess. New software only gets named when your current tools cannot do the job.',
  },
  {
    q: 'How fast do I see something?',
    a: 'The $750 audit is delivered the same day or next day. The Quick Assessment takes a week and the full audit takes two. On the full audit, one working automation ships live during the audit week, so you see something running and not only a report.',
  },
];

// FAQPage markup mirrors the visible FAQ above, same text from the same array.
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<Layout
title="AI Operations Consulting for Founder-Led Businesses | David J Forer"
description="AI operations consulting for founder-led businesses doing $1M to $5M. I map how your business actually runs, then build the systems that take the work off you. Start with an AI readiness audit." >
  <script is:inline type="application/ld+json" set:html={faqJson} />
  <div class="fs">

    <Hero />

    {/* Proof of the calculator number. Reads the case-studies collection. */}
    <CaseStudyProof />

    {/* What an audit gives you */}
    <section class="sec deliver">
      <div class="wrap grid2">
        <div class="reveal">
          <p class="tag sec-head">What an audit gives you</p>
          <h2>Four things you keep.</h2>
          <p class="keep">Whether or not you hire me again. Any developer or team can build from them.</p>
        </div>
        <div class="rows reveal">
          {deliverables.map((item, i) => (
            <div class="row-item">
              <span class="n">0{i + 1}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Pricing. Every number here is the same as on /ai-readiness-and-ai-audits#pricing.
         Do not change one without changing it in the private offer file first.
         Each tier books through a plain anchor. Calendly only loads for the hero button. */}
    <section class="pricing" id="pricing">
      <div class="wrap">
        <div class="pricing-head">
          <h2 class="reveal">Three audits, fixed prices.</h2>
          <p class="sub reveal">Each one stands alone. You keep everything and decide on implementation with the real findings in hand.</p>
        </div>

        <div class="invoices">
          {audits.map((tier, i) => (
            <article class={`inv reveal${tier.pick ? ' pick' : ''}`}>
              <div class="top tag"><span>No. 0{i + 1}</span><span>{tier.badge}</span></div>
              <h3>{tier.name}</h3>
              <p class="time">{tier.time}</p>
              <ul>
                {tier.points.map((point) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
              <div class="price-line"><span class="tag">Total</span><span class="price">{tier.price}</span></div>
              <a class={`btn ${tier.pick ? 'btn-flame' : 'btn-ink'}`} href={BOOKING}>{tier.cta} <span class="arr" aria-hidden="true">&rarr;</span></a>
            </article>
          ))}
        </div>

        <p class="impl reveal">Implementation runs $7,500 to $15,000, fixed scope, and is quoted only after an audit. <a href="/ai-readiness-and-ai-audits#pricing">See payment terms and add-ons</a></p>
      </div>
    </section>

    {/* Proof Section. Replaced unsourced expert quotes on 2026-09-17. */}
    {featuredBuilds.length > 0 && (
      <section class="proof">
        <div class="wrap">
          <p class="tag sec-head reveal">Proof of work</p>
          <h2 class="reveal">Systems I built and run every day.</h2>
          <p class="sub reveal">I do not ask a business to adopt anything I have not already put into production on my own operation. These run without me watching them.</p>

          <div class="builds reveal">
            {featuredBuilds.map((build) => (
              <a class="build" href={`/built/${build.slug}`}>
                <p class="tag">{build.data.buildType}</p>
                <h3>{build.data.title}</h3>
                <p class="desc">{build.data.description}</p>
                <span class="go">See how it works <span aria-hidden="true">&rarr;</span></span>
              </a>
            ))}
          </div>

          <a class="btn btn-ink reveal" href="/built">See everything I have built <span class="arr" aria-hidden="true">&rarr;</span></a>
        </div>
      </section>
    )}

    {/* How the work runs. Same six steps as the AUDIT_METHOD.md sequence. */}
    <section class="steps">
      <div class="wrap">
        <p class="tag sec-head reveal">How the work runs</p>
        <h2 class="reveal">Same sequence every time.</h2>
        <ol class="reveal">
          {steps.map((step, i) => (
            <li class={step.hot ? 'hot' : ''}>
              <span class="dot">{i + 1}</span>
              <p>
                {step.title}
                {step.note && <small>{step.note}</small>}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* Who you would work with */}
    <section class="bio">
      <div class="wrap grid-bio">
        <div class="photo reveal">
          <img
            src="/images/david-j-forer-li.jpeg"
            alt="David Forer"
            width="360"
            height="360"
            loading="lazy"
          />
        </div>
        <div class="reveal">
          <p class="tag sec-head">Who you would work with</p>
          <h2>David Forer</h2>
          <p>I have spent more than ten years in operations, most of it on the marketing and SEO side. That means I know how a business actually wins customers and what breaks when it grows faster than its systems.</p>
          <p>Now I use that to map how your work runs and build what takes it off you. I work with US businesses remotely, and I do every interview myself.</p>
          <a class="more" href="/about">More about me &rarr;</a>
        </div>
      </div>
    </section>

    {/* Questions. Sits in the same paper band as the bio above it. */}
    <section class="faq">
      <div class="wrap">
        <h2 class="sr-only">Questions founders ask first</h2>
        <div class="list reveal">
          {faqs.map((item) => (
            <details>
              <summary>{item.q} <i aria-hidden="true">+</i></summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* Closing call and the free guide, one band. */}
    <section id="giveaway" class="closing">
      <div class="wrap grid-closing">
        <div>
          <h2>Start with the number.</h2>
          <p class="lede">If it came out bigger than you expected, thirty minutes on a call is enough to see where it comes from.</p>
          <a class="btn btn-flame" href={BOOKING}>Book a Strategy Call <span class="arr" aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="guide guide-form">
          <h3>Fix First, Scale Smart</h3>
          <p>The 10 systems a growing business needs before adding AI to any of them, and the order to build them in. No cost, no call required.</p>
          <LeadForm
            formId="section"
            surveyId={GIVEAWAY_SURVEY}
            fields={GIVEAWAY_FIELDS}
            buttonText="Send me the guide"
            successHeading="It is yours."
            successBody="The guide is below. Grab it now, the link is on this page rather than in an email."
            successHref="/downloads/fix-first-scale-smart.pdf"
            successLinkText="Download Fix First, Scale Smart"
          />
        </div>
      </div>
    </section>

  </div>


  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Scroll reveals. Without IntersectionObserver, or with reduced motion,
      // everything is simply shown.
      const items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !reduceMotion) {
        const io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        items.forEach(function (el) { io.observe(el); });
      } else {
        items.forEach(function (el) { el.classList.add('in'); });
      }
    });
  </script>

</Layout>

<style>
  /* Colour tokens live in src/styles/tokens.css and load site-wide. One typeface
     only, inherited from the site (Bricolage Grotesque), so nothing here sets
     font-family. */
  :global(.fs) {
    background: var(--paper);
    color: var(--ink);
    font-size: 18px;
    line-height: 1.6;
    overflow: hidden;
  }

  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 28px; }
  .sr-only { position: absolute; left: -9999px; }
  h2, h3 { letter-spacing: -.025em; line-height: 1.04; }
  .tag { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; font-weight: 500; }
  .sec-head { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; color: var(--orange); }
  .sec-head::before { content: ""; width: 44px; height: 2px; background: currentColor; flex: none; }

  .btn { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 26px; border-radius: 999px; font-weight: 600; font-size: 17px; text-decoration: none; border: 2px solid transparent; cursor: pointer; transition: background .2s var(--ease); }
  .btn .arr { transition: transform .2s var(--ease); }
  .btn:hover .arr { transform: translateX(4px); }
  .btn:focus-visible, a:focus-visible, summary:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }
  .btn-flame { background: var(--flame); color: var(--navy); }
  .btn-flame:hover { background: #ff9347; }
  .btn-ink { background: var(--ink); color: #fff; }
  .btn-ink:hover { background: var(--navy-2); }

  /* deliverables */
  .sec { padding: 100px 0 110px; }
  .grid2 { display: grid; grid-template-columns: .8fr 1.2fr; gap: 70px; }
  .deliver h2 { font-size: clamp(38px, 5vw, 64px); font-weight: 800; }
  .keep { margin-top: 22px; color: var(--ink-2); max-width: 380px; }
  .rows { border-top: 4px solid var(--ink); }
  .row-item { display: grid; grid-template-columns: 96px 1fr; gap: 22px; padding: 30px 0; border-bottom: 1px solid var(--rule); align-items: start; transition: padding-left .3s var(--ease); }
  .row-item:hover { padding-left: 12px; }
  .n { font-weight: 800; font-size: 68px; line-height: .85; color: transparent; -webkit-text-stroke: 2px var(--orange); font-variant-numeric: tabular-nums; }
  .row-item h3 { font-size: 28px; margin-bottom: 8px; font-weight: 700; }
  .row-item p { color: var(--ink-2); max-width: 460px; }

  /* pricing */
  .pricing { background: var(--paper-2); padding: 120px 0; }
  .pricing h2 { font-size: clamp(38px, 5vw, 64px); font-weight: 800; max-width: 700px; }
  /* Headline sits on the right on purpose, to break the all-left rhythm of the page. */
  .pricing-head { text-align: right; }
  .pricing-head h2 { margin-left: auto; }
  .pricing-head .sub { margin-left: auto; }
  .sub { margin-top: 14px; color: var(--ink-2); max-width: 560px; }
  .invoices { margin-top: 60px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; align-items: stretch; }
  .inv { position: relative; background: var(--slip); padding: 30px 28px 28px; border: 1.5px solid var(--ink); display: flex; flex-direction: column; transition: transform .3s var(--ease), box-shadow .3s var(--ease); }
  .inv:hover { transform: translateY(-6px); box-shadow: 8px 8px 0 var(--ink); }
  .inv .top { display: flex; justify-content: space-between; color: var(--ink-2); padding-bottom: 14px; border-bottom: 2px dashed var(--ink); }
  .inv h3 { font-size: 26px; font-weight: 700; margin: 20px 0 4px; }
  .time { font-size: 15px; color: var(--ink-2); min-height: 48px; }
  .inv ul { list-style: none; margin: 18px 0 22px; padding: 0; flex: 1; }
  .inv li { display: grid; grid-template-columns: 20px 1fr; gap: 8px; padding: 9px 0; font-size: 16px; line-height: 1.45; border-bottom: 1px dotted var(--rule); }
  .inv li svg { width: 18px; height: 18px; margin-top: 3px; color: var(--orange); }
  .price-line { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; }
  .price-line .tag { font-size: 12px; color: var(--ink-2); }
  .price { font-weight: 800; font-size: 60px; letter-spacing: -.04em; line-height: 1; color: var(--orange); font-variant-numeric: tabular-nums; }
  .inv .btn { justify-content: center; }
  .inv.pick { background: var(--navy); color: #fff; border-color: var(--navy); transform: translateY(-22px); box-shadow: 10px 10px 0 var(--flame); }
  .inv.pick:hover { transform: translateY(-28px); box-shadow: 12px 12px 0 var(--flame); }
  .inv.pick .top { border-color: rgba(255,255,255,.5); color: var(--blue-ice); }
  .inv.pick .time, .inv.pick .price-line .tag { color: var(--blue-ice); }
  .inv.pick li { border-color: rgba(255,255,255,.18); }
  .inv.pick li svg, .inv.pick .price { color: var(--flame); }
  .impl { margin-top: 50px; color: var(--ink-2); }
  .impl a { color: var(--orange); font-weight: 600; }

  /* proof */
  .proof { padding: 120px 0; }
  .proof h2 { font-size: clamp(38px, 5vw, 64px); font-weight: 800; max-width: 760px; }
  .builds { margin-top: 54px; display: grid; grid-template-columns: repeat(3, 1fr); border: 1.5px solid var(--ink); }
  .build { display: flex; flex-direction: column; padding: 30px 28px; text-decoration: none; border-right: 1.5px solid var(--ink); transition: background .25s var(--ease), color .25s var(--ease); }
  .build:last-child { border-right: 0; }
  .build:hover { background: var(--ink); color: #fff; }
  .build .tag { color: var(--orange); margin-bottom: 46px; transition: color .25s; }
  .build:hover .tag { color: var(--flame); }
  .build h3 { font-size: 30px; font-weight: 700; margin-bottom: 12px; }
  .desc { flex: 1; color: var(--ink-2); transition: color .25s; }
  .build:hover .desc { color: var(--blue-ice); }
  .go { margin-top: 30px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .proof .btn { margin-top: 36px; }

  /* steps */
  .steps { background: var(--navy); color: #fff; padding: 110px 0 120px; }
  .steps h2 { font-size: clamp(38px, 5vw, 64px); font-weight: 800; color: #fff; }
  .steps .wrap > h2, .steps .wrap > .sec-head { text-align: center; justify-content: center; }
  .steps .sec-head::after { content: ""; width: 44px; height: 2px; background: currentColor; flex: none; }
  .steps li { text-align: center; }
  .steps .dot { margin: 0 auto; }
  .steps .sec-head { color: var(--flame); }
  .steps ol { list-style: none; position: relative; margin: 64px 0 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px; }
  .steps ol::before { content: ""; position: absolute; left: 0; right: 0; top: 25px; height: 2px; background: var(--navy-line); }
  .steps li { position: relative; padding-right: 8px; }
  .dot { position: relative; z-index: 1; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--navy); border: 2px solid var(--blue-ice); font-size: 18px; font-weight: 600; color: #fff; }
  .steps li.hot .dot { background: var(--flame); border-color: var(--flame); color: var(--navy); font-weight: 800; box-shadow: 0 0 0 8px rgba(255,122,31,.2); }
  .steps li p { margin-top: 18px; font-weight: 700; font-size: 21px; line-height: 1.15; letter-spacing: -.01em; }
  .steps li small { display: block; margin-top: 10px; font-weight: 400; font-size: 14.5px; color: var(--flame); line-height: 1.35; letter-spacing: 0; }

  /* bio */
  .bio { padding: 120px 0 70px; }
  .grid-bio { display: grid; grid-template-columns: 360px 1fr; gap: 70px; align-items: center; }
  .photo { position: relative; transform: rotate(-2deg); }
  .photo img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border: 1.5px solid var(--ink); }
  .photo::after { content: ""; position: absolute; inset: 14px -14px -14px 14px; border: 1.5px solid var(--orange); z-index: -1; }
  .bio h2 { font-size: clamp(40px, 5vw, 66px); font-weight: 800; margin-bottom: 22px; }
  .bio p:not(.sec-head) { max-width: 560px; color: var(--ink-2); font-size: 20px; }
  .bio p:not(.sec-head) + p { margin-top: 16px; }
  .more { display: inline-block; margin-top: 22px; font-weight: 600; color: var(--orange); }

  /* faq */
  .faq { padding: 30px 0 120px; }
  .list { border-top: 4px solid var(--ink); max-width: 880px; }
  .faq details { border-bottom: 1px solid var(--rule); padding: 24px 0; }
  .faq summary { list-style: none; display: flex; justify-content: space-between; gap: 20px; cursor: pointer; font-weight: 700; font-size: 26px; letter-spacing: -.015em; line-height: 1.15; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary i { font-style: normal; font-weight: 400; color: var(--orange); font-size: 30px; line-height: 1; transition: transform .3s var(--ease); }
  .faq details[open] summary i { transform: rotate(45deg); }
  .faq details p { margin-top: 14px; color: var(--ink-2); max-width: 700px; }

  /* closing */
  .closing { position: relative; background: var(--navy); color: #fff; padding: 120px 0; overflow: hidden; }
  .closing::before { content: ""; position: absolute; inset: 0; background: radial-gradient(800px 420px at 100% 0, rgba(255,122,31,.2), transparent 60%); }
  .grid-closing { position: relative; display: grid; grid-template-columns: 1.1fr .9fr; gap: 70px; align-items: end; }
  .closing h2 { font-size: clamp(46px, 7vw, 96px); font-weight: 800; line-height: .95; letter-spacing: -.04em; color: #fff; }
  .closing .lede { margin-top: 22px; max-width: 520px; font-size: 20px; color: var(--blue-ice); }
  .closing .btn { margin-top: 30px; }
  .guide { background: var(--navy-2); border: 1.5px solid var(--navy-line); padding: 30px; }
  .guide h3 { font-size: 28px; font-weight: 700; color: #fff; }
  .guide > p { margin-top: 8px; margin-bottom: 20px; color: var(--blue-ice); font-size: 16px; }
  /* The guide form is the shared LeadForm. These overrides only apply on this
     page: pale labels, orange button, name and email side by side. */
  .guide-form :global(form) { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; align-items: end; }
  .guide-form :global(form > div) { margin: 0; }
  .guide-form :global(label) { color: #dbeafe; font-weight: 600; }
  .guide-form :global(button[type="submit"]) { grid-column: 1 / -1; background: var(--flame); color: var(--navy); font-weight: 700; border-radius: 999px; }
  .guide-form :global(button[type="submit"]:hover) { background: #ff9347; }
  .guide-form :global([data-leadform-success] h3) { color: #ffffff; }
  .guide-form :global([data-leadform-success] p) { color: #dbeafe; }
