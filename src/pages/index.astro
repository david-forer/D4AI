---
// src/pages/index.astro - Homepage. AI operations consulting.
// SEO removed from this page entirely on 2026-09-17. It is a $2,500 add-on,
// not the offer, and leading with it was pulling the wrong buyer.
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ModalLeadMagnet from "../components/ModalLeadMagnet.astro";
import FormSection from '../components/FormSection.astro';
import { GIVEAWAY_SURVEY, GIVEAWAY_FIELDS } from '../lib/leadForms';
import { getCollection } from 'astro:content';

// Proof section. This replaced a "What Experts Say" block on 2026-09-17 that
// carried unsourced quotes attributed to Jason Calacanis, Mark Cuban and Dario
// Amodei under five-star review icons. None could be traced to a published
// source. Do not reinstate quotes from named people without a link to where
// they actually said it. The correct pattern is on /fix-the-chaos, which names
// the publication and states plainly that those people are not clients.
const featuredBuilds = (await getCollection('builds', ({ data }) =>
  data.featured === true && data.status !== 'archived'
)).slice(0, 3);
---

<Layout 
title="AI Operations Consulting for Founder-Led Businesses | David J Forer"
description="AI operations consulting for founder-led businesses doing $1M to $5M. I map how your business actually runs, then build the systems that take the work off you. Start with an AI readiness audit." >
  <div class="bg-gray-50 overflow-hidden">
  
<Hero />
      <!-- Problem/Pain Point Section -->
      <section class="py-16 md:py-24">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-800">
              Why Your Growth Plateaued
            </h2>
            <p class="text-lg text-gray-700 mb-12 text-center">
              You've hit a revenue ceiling not because of market demand, but because your operations can't scale. Without proper systems, every new customer or project adds more chaos instead of more profit.
            </p>
            
            <div class="grid md:grid-cols-2 gap-8 mb-12">
              <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
                <h3 class="font-bold text-xl mb-3 text-gray-800">Everyone is wearing too many hats</h3>
                <p class="text-gray-600">
                  Your team juggles multiple roles, leading to burnout and missed deadlines instead of focused execution.
                </p>
              </div>
              
              <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-500">
                <h3 class="font-bold text-xl mb-3 text-gray-800">Simple tasks take too long</h3>
                <p class="text-gray-600">
                  Basic operations that should take minutes consume hours due to manual processes and constant context switching.
                </p>
              </div>
            
              <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-400">
                <h3 class="font-bold text-xl mb-3 text-gray-800">You're drowning in disconnected tools</h3>
                <p class="text-gray-600">
                  You've invested in software to solve problems, but now spend more time managing disconnected apps than running your business.
                </p>
              </div>
             
              <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-300">
                <h3 class="font-bold text-xl mb-3 text-gray-800">AI feels like a problem, not a solution</h3>
                <p class="text-gray-600">
                  You know AI could help, but without a clear system, it's just another complex tool gathering digital dust.
                </p>
              </div>
              
              
            </div>

          
            
          </div>
        </div>
      </section>
      <!-- Stats Bar -->
      <section class="bg-blue-600 py-10">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-white text-center">
            <div>
              <p class="text-3xl md:text-4xl font-extrabold">$1M-$5M</p>
              <p class="text-blue-100 text-sm mt-1">Revenue range served</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-extrabold">5-20</p>
              <p class="text-blue-100 text-sm mt-1">Team size served</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-extrabold">8</p>
              <p class="text-blue-100 text-sm mt-1">Systems I built and run daily</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-extrabold">Fixed</p>
              <p class="text-blue-100 text-sm mt-1">Price, agreed before we start</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Is this you section? -->

      <section class="bg-gradient-to-b from-blue-600 to-blue-700 py-16">
        <div class="container mx-auto px-4">
          <!-- Header Section (now part of the same background) -->
          <div class="flex items-center flex-col px-4 mb-12">
            <p class="uppercase text-sm tracking-wider font-medium text-blue-100 leading-none">Who We Help</p>
            <h2 class="text-3xl lg:text-4xl pt-4 font-bold text-center leading-tight text-white lg:w-7/12 md:w-9/12 xl:w-5/12">Is This You?</h2>
            <p class="text-center text-white text-lg mt-3 max-w-2xl">Looking at your business, you're nodding to at least three of these:</p>
          </div>
          
          <!-- Content Grid -->
          <div class="mx-auto container flex flex-wrap px-2 lg:px-24">
            <!-- Item 1 -->
            <div class="flex sm:w-full md:w-1/2 lg:border-r md:border-r sm:border-r-0 border-blue-400 pb-10 lg:pt-6">
              <div class="flex flex-shrink-0 mr-5 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <div class="md:w-9/12 lg:w-9/12">
                <h3 class="text-lg font-semibold leading-5 text-white">Your $1M+ business runs on talent, not systems</h3>
                <p class="text-base text-blue-50 leading-normal xl:w-10/12 pt-2">Your success came from hustle and brilliance, but scaling further without proper operations feels like pushing water uphill.</p>
              </div>
            </div>
            
            <!-- Item 2 -->
            <div class="flex sm:w-full md:w-1/2 lg:pb-10 lg:pt-6">
              <div class="flex flex-shrink-0 sm:ml-0 md:ml-10 lg:ml-10 mr-5 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                </svg>
              </div>
              <div class="md:w-9/12 lg:w-9/12">
                <h3 class="text-lg font-semibold leading-5 text-white">You've bought AI tools that promised transformation</h3>
                <p class="text-base text-blue-50 leading-normal xl:w-10/12 pt-2">The tutorials made it look easy, but integration with your actual business processes remains elusive.</p>
              </div>
            </div>
            
            <!-- Item 3 -->
            <div class="flex sm:w-full md:w-1/2 lg:border-t md:border-t sm:border-t-0 lg:border-r md:border-r sm:border-r-0 border-blue-400 pt-10 lg:pb-20">
              <div class="flex flex-shrink-0 mr-5 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </div>
              <div class="md:w-9/12 lg:w-9/12">
                <h3 class="text-lg font-semibold leading-5 text-white">Your marketing lacks consistency and predictable results</h3>
                <p class="text-base text-blue-50 leading-normal xl:w-10/12 pt-2">Work happens in unpredictable bursts rather than as part of a reliable machine.</p>
              </div>
            </div>
            
            <!-- Item 4 -->
            <div class="flex sm:w-full md:w-1/2 lg:border-t md:border-t sm:border-t-0 border-blue-400 pt-10 lg:pb-20">
              <div class="flex flex-shrink-0 sm:ml-0 md:ml-10 lg:ml-10 mr-5 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="md:w-9/12 lg:w-9/12">
                <h3 class="text-lg font-semibold leading-5 text-white">You know you need better operations, but don't know where to start</h3>
                <p class="text-base text-blue-50 leading-normal xl:w-10/12 pt-2">The prospect of untangling your current setup while keeping revenue flowing seems impossible.</p>
              </div>
            </div>
          </div>
          
          <!-- Conclusion statement -->
          <div class="text-center mt-8 pb-6 text-white">
            <p class="text-xl font-medium">If this resonates, I'd welcome the opportunity to discuss how my work in AI and operations can help your business.</p>
          </div>
        </div>
      </section>

      <!-- Proof Section. Replaced unsourced expert quotes on 2026-09-17. -->
      <section class="py-16 md:py-20 bg-gray-50">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-4xl mx-auto text-center mb-12">
            <p class="uppercase text-sm tracking-wider font-medium text-blue-600 mb-3">Proof of work</p>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-800">Systems I built and run every day</h2>
            <p class="mt-4 text-lg text-gray-600">
              I do not ask a business to adopt anything I have not already put into production on my own operation.
              These run without me watching them.
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
            {featuredBuilds.map((build) => (
              <a href={`/built/${build.slug}`} class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 flex flex-col hover:shadow-md hover:border-blue-200 transition duration-150">
                <p class="uppercase text-xs tracking-wider font-medium text-blue-600 mb-3">{build.data.buildType}</p>
                <h3 class="text-lg font-semibold text-gray-800 mb-3">{build.data.title}</h3>
                <p class="text-gray-700 leading-relaxed flex-1">{build.data.description}</p>
                <div class="mt-6 pt-4 border-t border-gray-100">
                  <span class="text-sm font-medium text-blue-600">See how it works</span>
                </div>
              </a>
            ))}
          </div>

          <div class="text-center mt-10">
            <a href="/built" class="inline-flex items-center px-6 py-3 text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 transition duration-150">
              See everything I have built
            </a>
          </div>
        </div>
      </section>
    
<!-- AI Confusion to results -->
      <section class="py-16 bg-white">
        <div class="container max-w-6xl mx-auto px-4">
          <div class="grid md:grid-cols-2 gap-12 md:items-center">
            <!-- Left Column: Title and Description -->
            <div class="flex flex-col justify-center">
              <h2 class="text-3xl font-bold mb-6">Go From AI Confusion to Operational Clarity & Predictable Results</h2>
              <p class="text-gray-700 mb-4">
                Most businesses struggle with random AI tools and inconsistent processes. The Owner's OS provides a systematic framework that transforms chaos into operational excellence.
              </p>
            </div>
            
            <!-- Right Column: Numbered Points -->
            <div class="space-y-8">
              <!-- Point 1 -->
              <div class="flex items-start">
                <div class="flex-shrink-0 mr-6">
                  <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-2xl font-bold">
                    1
                  </div>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-2">From Guesswork to Growth Engine</h3>
                  <p class="text-gray-700">Transform scattered tactics into a systematic approach where AI and operations work together seamlessly. Watch your business evolve from reactive firefighting to strategic scaling with predictable revenue you can forecast and rely on.</p>
                </div>
              </div>
      
              <!-- Point 2 -->
              <div class="flex items-start">
                <div class="flex-shrink-0 mr-6">
                  <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-2xl font-bold">
                    2
                  </div>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-2">Effortless Scale Through Systems</h3>
                  <p class="text-gray-700">Double your output while your team breathes easier. With clear processes and AI integration, you'll scale without adding headcount. Maintaining quality even as your business expands and eliminating the constant "how do we do this again?" questions that drain momentum.</p>
                </div>
              </div>
      
              <!-- Point 3 -->
              <div class="flex items-start">
                <div class="flex-shrink-0 mr-6">
                  <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-2xl font-bold">
                    3
                  </div>
                </div>
                <div>
                  <h3 class="text-xl font-bold mb-2">Results You Can Measure and See</h3>
                  <p class="text-gray-700">Connect every operational improvement directly to revenue, time saved, and improved margins. Replace vanity metrics with clear attribution and ensure your AI investments deliver measurable value instead of gathering digital dust in the background.</p>
                </div>
              </div>
     
          </div>
        </div>
      </section>

      <!-- Audit CTA. Replaced the "Automate Your SEO with AI" lead magnet on
           2026-09-17. That block led with SEO and claimed "Save 10+ hours/week",
           a number with nothing behind it. The homepage never named the actual
           offer until now. -->
      <section class="py-16 md:py-24 bg-blue-50">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl mx-auto text-center">
            <h2 class="text-3xl md:text-4xl font-bold mb-6 text-gray-800">
              Start with an AI Readiness Audit
            </h2>
            <p class="text-lg text-gray-700 mb-8">
              Two to three hours with you, and you get back a documented map of how your business
              actually runs, plus the automation opportunities ranked by what each one costs you
              per year. You keep the documentation whether or not you ever hire me again.
            </p>
            <a href="/ai-readiness-and-ai-audits#pricing" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded-xl transition duration-200">
              See audit options and pricing
            </a>
            <p class="text-sm text-gray-600 mt-4">From $750. Fixed price, agreed in writing before anything starts.</p>
          </div>
        </div>
      </section>

     
      <!-- What the work involves. Rebuilt 2026-09-17. The previous six cards named
           services that are not sold ("Strategic AI Tool Selection", "Content
           Workflow Automation") and two icons did not match their label. These six
           are the actual sequence from AUDIT_METHOD.md. -->
      <section class="py-14 bg-white">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl mx-auto text-center mb-10">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-3">What the work actually involves</h2>
            <p class="text-gray-600">Same sequence every time, scaled to how much of the business is in scope.</p>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-8 max-w-5xl mx-auto">
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">1. Map how the work actually runs</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Process by process, in interviews. What goes in, the judgment calls nobody has written down, and where the output lands.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">2. Put a number on what it costs</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Every finding ranked by what it costs you per year. Four people losing twenty hours a week beats one loud complaint about a short task.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">3. Find where the work waits on you</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Hours per week where the business stops until you personally do something, priced at what your time is actually worth.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">4. Build the automations</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Fixed scope, named in writing before anything starts. On a full audit the first one goes live during the audit week itself.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">5. Write it down so it survives</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Plain English SOPs, one page per process. You keep them whether or not you ever hire me again.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">6. Train the team to run it</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Role based and hands on. A system nobody adopts is a system you paid for twice.</p>
          </div>
        </div>
          </div>
          <div class="text-center mt-10">
            <a href="/ai-readiness-and-ai-audits#pricing" class="text-blue-600 font-semibold hover:underline">See what an audit costs</a>
          </div>
        </div>
      </section>

      <!-- Final CTA Section -->
      
    </div>
    
  
    
    <!-- Simple back to top button -->
    <button id="back-to-top" aria-label="Back to top" class="fixed bottom-6 right-6 bg-blue-600 text-white p-2 rounded-full shadow-lg opacity-0 invisible transition-all duration-300 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:outline-none">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
      </svg>
    </button>
    
    <script>
      // Back to top button functionality
      document.addEventListener('DOMContentLoaded', function() {
        const backToTopButton = document.getElementById('back-to-top');
        
        if (backToTopButton) {
          window.addEventListener('scroll', function() {
            if (window.scrollY > 500) {
              backToTopButton.classList.replace('opacity-0', 'opacity-100');
              backToTopButton.classList.replace('invisible', 'visible');
            } else {
              backToTopButton.classList.replace('opacity-100', 'opacity-0');
              setTimeout(() => {
                backToTopButton.classList.replace('visible', 'invisible');
              }, 300);
            }
          });
          
          backToTopButton.addEventListener('click', function() {
            window.scrollTo({
              top: 0,
              behavior: 'smooth'
            });
          });
        }
      });
    </script>

  <FormSection
    id="giveaway"
    heading="Before you go, take the systems guide"
    blurb="Fix First, Scale Smart. The 10 systems a growing business needs before adding AI to any of them, and the order to build them in. No cost, no call required."
    surveyId={GIVEAWAY_SURVEY}
    fields={GIVEAWAY_FIELDS}
    buttonText="Send me the guide"
