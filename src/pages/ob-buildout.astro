---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';

// Was an 800px myformflow.io iframe. Replaced 2026-09-16 with the native
// LeadForm because myformflow submissions never reached David's inbox. This
// posts to the SAME survey as /contact, which is already in the map in the
// Pipedream `format_lead` step, so alerting works with no dashboard changes.
//
// All three "Get Started" buttons on /operational-buildout point here, so this
// is a live conversion path and not a spare page.
//
// Element ids are the contact survey's, read off blocks[].elements[]. Block ids
// look identical and silently swallow values on a 200.
const CONTACT_SURVEY = 'cmayiuvf4000eoj01699d8ivo';
const CONTACT_FIELDS = [
  {
    name: 'contact',
    questionId: 'vxs2tmtbi52fq5snqgx83gp2',
    label: 'Let me know who you are',
    type: 'contactInfo',
    // Order is positional in Formbricks. Do not reorder.
    parts: [
      { name: 'firstName', label: 'First Name', required: true },
      { name: 'lastName', label: 'Last Name', required: true },
      { name: 'email', label: 'Email', type: 'email', required: true },
      { name: 'phone', label: 'Phone', type: 'tel', required: true },
      { name: 'company', label: 'Company', required: true },
    ],
  },
  {
    name: 'help_with',
    questionId: 'zu9rzc9vv4sakenz7aly6ftd',
    label: 'What do you need built?',
    type: 'checkboxes',
    required: true,
    options: ['AI Integration', 'Operations', 'SEO', 'All of the Above'],
  },
  {
    name: 'detail',
    questionId: 'g62r1w2ry5i3tqsf5anwmlaf',
    label: 'Where does the work get stuck today?',
    type: 'textarea',
    required: false,
    rows: 5,
  },
];
---

<Layout title="Operational Buildout - D4AI" noindex={true}>
  {/* Blue header section */}
  <section class="bg-blue-600 py-16">
    <div class="max-w-5xl mx-auto px-6  text-center">
      <h1 class="text-5xl font-bold text-white mb-6">Let's Build Your Operational Engine</h1>
      <p class="text-2xl text-white">
        This short form helps us understand your business, your bottlenecks, and which buildout package is the right fit.
        No vague pricing. No pushy sales. Just clarity.
      </p>
    </div>
  </section>

  {/* Form section */}
  <section class="max-w-3xl mx-auto px-6 py-8">
    <div class="w-full bg-white rounded-lg shadow-lg p-8">
      <LeadForm
        surveyId={CONTACT_SURVEY}
        fields={CONTACT_FIELDS}
        buttonText="Send This Over"
        successHeading="Thanks, that came through."
        successBody="I read these myself and I typically respond within 1 to 2 business days."
      />
    </div>
  </section>
</Layout>
