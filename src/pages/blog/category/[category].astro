---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { HUBS, HUB_BY_SLUG } from "../../../lib/hubs";

// One hub page per entry in src/lib/hubs.ts. Nothing here is hardcoded, so
// adding a hub is a one-line change in that file and this route follows.
export async function getStaticPaths() {
  return HUBS.map((h) => ({ params: { category: h.slug } }));
}

const { category } = Astro.params;
const meta = HUB_BY_SLUG[category as string];

// Nav chips, same order as the hub file.
const categories = HUBS.map((h) => ({ slug: h.slug, name: h.name }));

// Posts carry exactly one tag and it is a hub slug, enforced by the schema in
// src/content/config.ts, so this is an equality test rather than a search.
const allPosts = await getCollection("blog");
const filteredPosts = allPosts
  .filter((post) => post.data.tags?.[0] === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const defaultPostImage = "/images/ai-operations-logo.webp";
---

<Layout title={`${meta.name} Articles | David J Forer`} description={meta.description}>
  <div>
    {/* Hero Section */}
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 py-24 relative">
      <div class="container mx-auto px-6 max-w-6xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">{meta.h1}</h1>
        <p class="text-blue-100 text-xl max-w-4xl mx-auto leading-relaxed">{meta.description}</p>
        {meta.serviceLink && (
          <a href={meta.serviceLink} class="inline-block mt-8 px-8 py-3 bg-white text-blue-700 font-semibold rounded-md hover:bg-blue-50 transition-colors">
            {meta.serviceLabel}
          </a>
        )}
      </div>
      {/* Scroll indicator arrow */}
      <div class="absolute bottom-6 left-1/2 -translate-x-1/2 scroll-arrow">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </section>

    {/* Category Navigation */}
    <div class="border-b border-gray-200 bg-white sticky top-0 z-10 shadow-sm">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="flex flex-wrap justify-center gap-2 md:gap-6 py-3">
          <a href="/blog" class="px-4 py-2 rounded-md transition-colors text-blue-700 hover:text-blue-900 hover:bg-blue-50 text-sm font-medium">
            All Posts
          </a>
          {categories.map(cat => (
            <a
              href={`/blog/category/${cat.slug}`}
              class={`px-4 py-2 rounded-md transition-colors text-sm font-medium ${category === cat.slug ? 'bg-blue-600 text-white' : 'text-blue-700 hover:text-blue-900 hover:bg-blue-50'}`}
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    {/* Category Body Content */}
    {meta.body && (
      <div class="bg-gray-50 border-b border-gray-100">
        <div class="container mx-auto px-6 max-w-6xl py-14">
          <div class="max-w-4xl">
            {meta.body.split('\n\n').map(para => (
              <p class="text-gray-700 text-lg leading-relaxed mb-5">{para}</p>
            ))}
          </div>
        </div>
      </div>
    )}

    {/* Blog Posts Grid */}
    <div class="container mx-auto px-6 max-w-6xl py-16">
      <h2 class="text-2xl font-bold mb-10 text-gray-900">
        {filteredPosts.length} {meta.name} Article{filteredPosts.length !== 1 ? 's' : ''}
      </h2>

      {filteredPosts.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {filteredPosts.map((post, i) => (
            <div class="group overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-shadow border border-gray-100 bg-white">
              <div class="relative aspect-[16/9] overflow-hidden bg-blue-100">
                <img
                  src={post.data.heroImage || defaultPostImage}
                  alt={post.data.title}
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="p-6">
                <a href={`/blog/${post.slug}`} class="block">
                  <h3 class="text-lg font-semibold mb-2 text-blue-700 group-hover:text-blue-800 transition-colors leading-snug">
                    {post.data.title}
                  </h3>
                </a>
                <p class="text-gray-500 text-sm mb-3">
                  {new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </p>
                <p class="text-gray-600 line-clamp-3 mb-4 text-sm leading-relaxed">{post.data.description}</p>
                <a href={`/blog/${post.slug}`} class="inline-block text-blue-600 hover:text-blue-800 text-sm font-medium hover:underline">
                  Read More<span class="sr-only"> about {post.data.title}</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-gray-600 mb-4">No articles found in this category yet.</p>
          <a href="/blog" class="inline-block px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
            View all articles
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .scroll-arrow {
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }
</style>