---
import Layout from '../layouts/Layout.astro';
import ModalLeadMagnet from '../components/ModalLeadMagnet.astro';
import { GIVEAWAY_SURVEY, GIVEAWAY_FIELDS } from '../lib/leadForms';

// Every card describes something that is live today. Do not add results
// figures without a source. The readiness checklist uses the same modal and
// survey as the homepage hero, and arrives by reply.
const groups = [
  {
    heading: 'Guides and checklists',
    items: [
      {
        label: 'Free guide',
        title: 'Fix First, Scale Smart',
        text: 'The 10 systems a growing business needs before adding AI to any of them, and the order to build them in.',
        href: '/#giveaway',
        cta: 'Get the guide',
      },
      {
        label: 'Free checklist',
        title: 'AI readiness checklist',
        text: 'The questions I work through with a founder before recommending a single tool. Two fields and it lands in your inbox.',
        modal: 'ai-audit-modal',
        cta: 'Get the checklist',
      },
      {
        label: 'Free by email',
        title: 'AI playbooks and checklists',
        text: '10 step-by-step guides for automating the work your team does by hand, like lead intake, client onboarding and SOPs.',
        href: '/playbooks-checklists',
        cta: 'Get the playbooks',
      },
      {
        label: 'Guide',
        title: 'Founder bottlenecks',
        text: 'A diagnostic for the decisions and know-how that only live in your head, and how to hand them to your team. Run it on yourself first.',
        href: '/founder-bottlenecks',
        cta: 'Read the guide',
      },
    ],
  },
  {
    heading: 'Tools you can use today',
    items: [
      {
        label: 'Free tools',
        title: 'Custom GPTs',
        text: 'The GPTs I built for my own work, including an SOP Specialist and a Support Response Assistant. Open one in ChatGPT and use it today.',
        href: '/custom-gpts',
        cta: 'See the GPTs',
      },
      {
        label: 'Skills and agents',
        title: 'What I built',
        text: 'The Claude skills and agents that run my own business, from a Monday operating briefing to the system that drafts this blog. See how each one works.',
        href: '/built',
        cta: 'See the builds',
      },
    ],
  },
  {
    heading: 'Articles',
    items: [
      {
        label: 'Articles',
        title: 'AI operations',
        text: 'How a small business runs day to day with AI in the workflow, and where to start.',
        href: '/blog/category/ai-operations',
        cta: 'Read the AI operations articles',
      },
      {
        label: 'Articles',
        title: 'AI automation',
        text: 'Which work to automate first, how to build it so it holds up, and what it costs.',
        href: '/blog/category/automation',
        cta: 'Read the automation articles',
      },
      {
        label: 'Articles',
        title: 'SEO and AI',
        text: 'How I run SEO for a small business, with AI doing most of the research and drafting.',
        href: '/blog/category/seo',
        cta: 'Read the SEO articles',
      },
    ],
  },
];

const cardClass = 'group bg-white rounded-xl p-8 shadow-sm border-t-4 border-blue-600 hover:shadow-md transition duration-300 flex flex-col text-left';
---

<Layout title="AI Resources for Small Business Owners – Free Playbooks, Checklists, and Custom GPTs – Guides on Founder Bottlenecks and SEO Operations – David J Forer" description="A free library of AI resources for small business owners: playbooks, checklists, custom GPTs, and guides covering founder bottlenecks, SEO, and operations.">
	<section class="bg-gradient-to-r from-blue-600 to-blue-800 py-20 relative overflow-hidden text-lg md:text-xl">
		{/* Background texture, same triangles as the AI training hero. Decorative only. */}
		<div class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true">
			<div class="absolute top-16 left-24 w-44 h-44 bg-amber-200" style="clip-path: polygon(50% 0, 100% 100%, 0 100%)"></div>
			<div class="absolute bottom-20 right-20 w-56 h-56 bg-orange-200" style="clip-path: polygon(50% 100%, 0 0, 100% 0)"></div>
			<div class="absolute top-1/3 left-1/2 w-24 h-24 bg-yellow-100" style="clip-path: polygon(50% 0, 100% 100%, 0 100%)"></div>
		</div>
		<div class="container mx-auto px-6 max-w-4xl relative z-10 text-center">
			<p class="inline-block bg-white/15 border border-white/30 text-white text-lg md:text-xl font-bold uppercase tracking-wider rounded-full py-2 px-6 mb-6">Free to use</p>
			<h1 class="text-4xl md:text-5xl font-bold text-white leading-tight mb-6">AI resources for small business owners</h1>
			<p class="text-blue-50 max-w-3xl mx-auto">Guides, checklists and tools I built for founders running 5 to 20 people.</p>
		</div>
	</section>

	{/* Why it is free */}
	<section class="bg-white py-16 px-6 text-lg md:text-xl">
		<div class="max-w-3xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-8 text-center">Why I give this away</h2>
			<div class="text-gray-700 leading-relaxed space-y-6">
				<p>Not every business can hire help right now. Some founders would rather build it themselves, and plenty of them do it well.</p>
				<p>Everything on this page is the same thinking I use with paying clients. Take what you need and put it to work. If you get stuck, or you'd rather hand it off, you'll already know how I work before we talk.</p>
			</div>
		</div>
	</section>

	{groups.map((g, gi) => (
		<section class={`${gi % 2 === 0 ? 'bg-gray-50' : 'bg-slate-200'} py-16 px-6 text-lg md:text-xl`}>
			<div class="max-w-5xl mx-auto">
				<h2 class="text-3xl font-bold text-gray-800 text-center mb-10">{g.heading}</h2>
				<div class={`grid gap-6 ${g.items.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2'}`}>
					{g.items.map((r) => r.modal ? (
						<button type="button" data-open-modal={r.modal} class={cardClass}>
							<span class="text-sm font-semibold uppercase tracking-widest text-blue-600 mb-2">{r.label}</span>
							<span class="text-2xl font-bold text-gray-800 mb-3">{r.title}</span>
							<span class="text-gray-700 mb-6 flex-grow">{r.text}</span>
							<span class="text-blue-700 font-semibold group-hover:underline">{r.cta} &rarr;</span>
						</button>
					) : (
						<a href={r.href} class={cardClass}>
							<span class="text-sm font-semibold uppercase tracking-widest text-blue-600 mb-2">{r.label}</span>
							<h3 class="text-2xl font-bold text-gray-800 mb-3">{r.title}</h3>
							<span class="text-gray-700 mb-6 flex-grow">{r.text}</span>
							<span class="text-blue-700 font-semibold group-hover:underline">{r.cta} &rarr;</span>
						</a>
					))}
				</div>
			</div>
		</section>
	))}

	<section class="py-16 bg-blue-600 text-white text-lg md:text-xl">
		<div class="container mx-auto px-6 max-w-3xl text-center">
			<h2 class="text-3xl md:text-4xl font-bold mb-6">Want help putting these to work?</h2>
			<p class="text-blue-50 mb-8">Start with the free process audit. You get your top 5 automation opportunities, priced in dollars.</p>
			<a href="/fix-the-chaos" class="inline-block bg-white text-blue-700 font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-blue-50 transition duration-300">Get the free process audit</a>
		</div>
	</section>

	<ModalLeadMagnet
		showModalId="ai-audit-modal"
		formTitle="Get the AI readiness checklist"
		formDescription="The questions I work through before recommending a single tool. Two fields, no call."
		surveyId={GIVEAWAY_SURVEY}
		fields={GIVEAWAY_FIELDS}
		buttonText="Send it over"
		successHeading="Got it."
		successBody="Your details are in. I send this out personally, so give me a day."
	/>
</Layout>
