---
import Layout from '../layouts/Layout.astro';
import FormSection from '../components/FormSection.astro';
import { SEO_SURVEY, SEO_FIELDS } from '../lib/leadForms';

const pageUrl = 'https://davidjforer.com/seo-accelerator';

// Form fields and the Formbricks element ids live in src/lib/leadForms.ts.
// Chrome comes from FormSection, so every form on the site matches.

// The FAQ block below is the single source for both the visible section and the
// FAQPage schema. Edit here, never in the markup, or the two drift apart.
// Questions 1 to 3 were added 2026-09-18 from the live SERP for "seo
// accelerator": the term is split between agency services, training courses and
// indexing software, and Google's own AI Overview closes by asking the searcher
// which one they mean. Nothing on page one answers that and then sells.
const faqs = [
  {
    q: 'What is an SEO accelerator?',
    a: 'An SEO accelerator is a fixed-scope engagement that compresses the first phase of search work. The audit, the keyword map and the priority order arrive up front, so execution runs against a list that already exists from month 1. The same name also gets used for training courses and for indexing software, which is why search results for the term look so mixed.',
  },
  {
    q: 'Is an SEO accelerator a service, a course, or software?',
    a: 'All three use the name. Agencies sell it as a fixed-scope project or a monthly execution program. Training companies sell it as a course covering keyword research, technical auditing and client acquisition. Software companies sell it as a tool for instant indexing, crawl budget control or static snapshots. This page is the first kind: a paid audit, then optional execution against the roadmap that audit produces.',
  },
  {
    q: 'How is this different from an SEO retainer?',
    a: 'A retainer buys hours and finds the work as it goes. This starts with a $2,500 audit that writes every finding as a specific action, ordered by what it is worth. If you take the $997 a month execution step, the deliverables are named and agreed before the month starts. Plenty of businesses take the audit, hand it to the agency they already use, and stop there.',
  },
  {
    q: 'What does an SEO accelerator cost?',
    a: 'Fixed-scope audits from independent consultants run roughly $2,000 to $5,000 depending on site size. Monthly execution sits anywhere from $500 to $10,000 and up. This one is $2,500 for an audit of roughly 50 pages, then $997 a month for execution with a 6 month minimum. Free training courses exist if you want to learn the work instead of buying it.',
  },
  {
    q: 'How long before I see results?',
    a: 'Initial ranking movement usually shows between weeks 4 and 8. Traffic change that means anything takes 3 to 6 months, which is why the execution step carries a 6 month minimum. Anyone promising faster is selling ads with an SEO label on them.',
  },
  {
    q: 'What makes semantic SEO different?',
    a: 'Semantic SEO covers a subject completely rather than chasing one phrase at a time, so a single page can rank for dozens of related searches. Search engines now match meaning and entity relationships, so covering a subject properly reaches more queries than repeating a keyword.',
  },
  {
    q: 'Do you guarantee rankings?',
    a: 'No. Nobody controls Google’s index, and a provider who guarantees a position is either buying it with ads or lying to you. What I guarantee is the method, the priority order, and a monthly report showing what moved and what did not.',
  },
  {
    q: 'What does implementation involve?',
    a: 'I handle the audit, the analysis and the roadmap. Implementation is your call. I can make the changes directly, or hand your team written instructions and review the result.',
  },
  {
    q: 'Is this suitable for my industry?',
    a: 'It works across most service businesses. If your niche needs a different approach, I will say so before you pay anything. The initial assessment exists for that reason.',
  },
  {
    q: 'What ongoing support do you provide?',
    a: 'The execution step includes monthly performance monitoring, a report written against the audit findings, and the next month’s deliverables agreed in advance. The audit on its own is one-time work with no ongoing commitment attached to it.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'SEO Accelerator',
      description:
        'A fixed-scope SEO engagement for small businesses: a $2,500 audit of roughly 50 pages, then optional monthly execution against the roadmap it produces.',
      about: 'SEO accelerator programs for small businesses',
      audience: {
        '@type': 'Audience',
        audienceType:
          'Founders of service businesses between $1M and $5M in revenue with 5 to 20 staff',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://davidjforer.com' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://davidjforer.com/services' },
        { '@type': 'ListItem', position: 3, name: 'SEO Accelerator', item: pageUrl },
      ],
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'SEO Accelerator',
      serviceType: 'Search engine optimization audit and execution',
      description:
        'A fixed-scope SEO audit covering technical analysis, semantic keyword research and a content gap analysis, with optional monthly execution against the resulting roadmap.',
      provider: { '@type': 'Person', name: 'David J Forer', url: 'https://davidjforer.com' },
      areaServed: { '@type': 'Country', name: 'United States' },
      offers: [
        {
          '@type': 'Offer',
          name: 'SEO Audit',
          description: 'One-time audit of roughly 50 pages. Technical audit, semantic keyword research and a content gap analysis.',
          price: '2500',
          priceCurrency: 'USD',
          url: `${pageUrl}#pricing`,
          availability: 'https://schema.org/InStock',
        },
        {
          '@type': 'Offer',
          name: 'Execution',
          description: 'Monthly execution against the audit roadmap with named deliverables agreed in advance. Six month minimum.',
          price: '997',
          priceCurrency: 'USD',
          url: `${pageUrl}#pricing`,
          availability: 'https://schema.org/InStock',
          eligibleDuration: { '@type': 'QuantitativeValue', value: 6, unitCode: 'MON' },
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

{/* Title shortened from 139 chars on 2026-09-18, David's call. This URL is NOT a
     valid arm of the long-title A/B test: Google was rewriting the long title to
     "SEO Accelerator - AI SEO Operations" (35 chars), so the treatment was never
     served. Band across the 10 pages ranking for "seo accelerator" is 43 to 63
     chars, median 57.5. The long-title test stands on every other page. */}
<Layout title="SEO Accelerator: What It Is and What One Costs | David J Forer" description="What an SEO accelerator is, the 3 forms it gets sold in, and what a fixed-scope $2,500 audit of roughly 50 pages covers."
image="/images/seo-accelerator.webp">
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
<div class="bg-white text-gray-800 font-sans">

    <section class="bg-gradient-to-r from-blue-600 to-blue-800 py-20 relative overflow-hidden">
        {/* Background texture. Angled bars, a rising motif, wide capsules rather than blocks. Decorative only. */}
        <div class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true">
            <div class="absolute top-24 left-12 w-64 h-10 rounded-full -rotate-12 bg-emerald-200"></div>
            <div class="absolute bottom-16 right-16 w-80 h-12 rounded-full rotate-6 bg-lime-200"></div>
            <div class="absolute top-1/2 left-1/2 w-40 h-8 rounded-full -rotate-6 bg-teal-100"></div>
        </div>
        <div class="container mx-auto px-6 max-w-6xl relative z-10">
            <div class="text-center">
                <div>
                    <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">SEO Accelerator</h1>
                    <h2 class="text-xl md:text-2xl text-blue-100 mb-6">A fixed-scope SEO engagement for small businesses</h2>
                    <p class="text-white text-lg mb-8">The audit comes first: roughly 50 pages, every finding written as a specific action, ordered by what it is worth. Execution afterwards is optional, and the audit is yours to keep either way.</p>
                    <a href="#pricing" class="bg-white text-blue-700 font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-blue-50 transition duration-300">See what it costs</a>
                </div>

            </div>
        </div>
    </section>

    {/* Definitional section, added 2026-09-18. The live SERP for "seo accelerator"
         is split between agency services (acceleratorseo, jakala, seospace),
         training courses (logeix, moz, learningseo) and indexing software. Google's
         AI Overview for the term ends by asking the searcher which one they want,
         which means no page on page one owns the definition and then sells. The
         page previously opened straight into the pitch. */}
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-6">What an SEO accelerator is</h2>

            <p class="text-lg text-gray-700 mb-4">An SEO accelerator is a fixed-scope engagement that compresses the first phase of search work. The audit, the keyword map and the priority order arrive up front, so execution runs against a list that already exists from month 1.</p>

            <p class="text-lg text-gray-700 mb-10">Three different products sell under the name, which is why the search results for it look so mixed.</p>

            <div class="space-y-8">
                <div class="border-l-4 border-blue-600 pl-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-2">As an agency service</h3>
                    <p class="text-gray-600">A fixed-scope project, or a monthly program, that clears technical errors, rewrites on-page content and produces a growth roadmap. Priced per project or per month.</p>
                </div>

                <div class="border-l-4 border-blue-600 pl-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-2">As a training program</h3>
                    <p class="text-gray-600">A course or bootcamp covering keyword research, technical auditing, AI-assisted content and client acquisition. Several of the ones ranking for this term are free. The buyer here wants to do the work themselves.</p>
                </div>

                <div class="border-l-4 border-blue-600 pl-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-2">As software</h3>
                    <p class="text-gray-600">Tools for instant indexing, crawl budget control, or serving static snapshots to search bots. These solve one narrow technical problem and do nothing about content, relevance or authority.</p>
                </div>

                <div class="border-l-4 border-blue-600 pl-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Which one this is</h3>
                    <p class="text-gray-600">The first kind. A $2,500 audit of roughly 50 pages, then optional monthly execution against the roadmap that audit produces. No course, no software license, no open-ended retainer.</p>
                </div>

                <div class="border-l-4 border-blue-600 pl-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-2">What accelerates, and what does not</h3>
                    <p class="text-gray-600">Discovery compresses well. A technical audit that an agency spreads across 3 months is about a week of work when it is the only thing being done, and the same is true of keyword research and a content gap analysis. Authority does not compress. Links, citations and the age of a domain move on their own schedule, and no accelerator changes that. A provider selling speed on authority is selling ads.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-16 text-center">The 7 steps, in order</h2>
            
            <div class="space-y-12">
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">1</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Technical site audit</h3>
                        <p class="text-gray-600 mb-4">I run a technical analysis to identify issues affecting your search performance, including site structure, loading speed, mobile optimization, and crawlability.</p>
                        <div class="bg-white p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Deliverable:</strong> Detailed technical audit report with prioritized issues</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">2</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Competitor research and positioning</h3>
                        <p class="text-gray-600 mb-4">I work through your top competitors to identify their successful strategies, content gaps you can fill, and opportunities to differentiate your business in search results.</p>
                        <div class="bg-white p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Deliverable:</strong> Competitive analysis report with strategic recommendations</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">3</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Semantic keyword research</h3>
                        <p class="text-gray-600 mb-4">I use AI tools to find the keywords and topic clusters that match what your buyers search for, and that can bring qualified traffic to your site.</p>
                        <div class="bg-white p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Deliverable:</strong> Strategic keyword map with semantic topic clusters</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">4</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">On-page work and content</h3>
                        <p class="text-gray-600 mb-4">I rewrite the pages worth rewriting and map the content plan that addresses user questions, incorporates semantic relevance, and positions you as an authoritative source.</p>
                        <div class="bg-white p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Deliverable:</strong> On-page optimization report and content strategy</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">5</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Technical implementation</h3>
                        <p class="text-gray-600 mb-4">I make the technical fixes that are actually costing you, addressing issues with site speed, mobile responsiveness, schema markup, and other technical factors that affect rankings.</p>
                        <div class="bg-white p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Deliverable:</strong> Technical implementation report with performance metrics</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">6</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Authority and off-page work</h3>
                        <p class="text-gray-600 mb-4">I plan the work that raises your site's authority through high-quality backlinks, digital PR campaigns, and strategic partnerships that signal your site's credibility to search engines.</p>
                        <div class="bg-white p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Deliverable:</strong> Authority building plan with target opportunities</p>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col md:flex-row gap-8 items-center">
                    <div class="md:w-1/4 flex justify-center">
                        <div class="w-20 h-20 bg-blue-700 rounded-full flex items-center justify-center text-white text-2xl font-bold">7</div>
                    </div>
                    <div class="md:w-3/4">
                        <h3 class="text-2xl font-bold text-gray-800 mb-2">Tracking and what changes next</h3>
                        <p class="text-gray-600 mb-4">Tracking is set up so the reporting answers one question: did the thing I shipped move anything. What did not move gets dropped from the roadmap.</p>
                        <div class="bg-white p-4 rounded-lg border border-gray-200">
                            <p class="text-sm text-gray-500"><strong>Deliverable:</strong> Regular performance reports and optimization recommendations</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {/* The "Why Choose Our SEO Accelerator Service" two-column block was cut on
         2026-09-18. Eight bullets of template copy (Semantic SEO Approach,
         Sustainable Growth and so on) that repeated the 7 steps and the new
         definitional section. The page was already above the p75 band on heading
         and paragraph count against the 10 ranking pages, so this was the cheapest
         thing to lose. */}

    {/* Page order set by David 2026-09-18: explain, price, form, questions,
         related reading. The FAQ used to sit here, above pricing. It now runs
         after the form so the questions answer objections at the point someone
         has already seen the price and the form. */}

    {/* Pricing. Replaced a commented-out Starter/Growth/Scale block on 2026-09-17.
         The monthly is fixed-scope execution of the audit roadmap with a named
         deliverable, not a retainer. Do not change a number here without changing
         it in the private offer file first. */}
    <section id="pricing" class="py-16 bg-white">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-4 text-center">What this costs</h2>
            <p class="text-lg text-gray-700 mb-12 text-center max-w-3xl mx-auto">
                The audit comes first and stands on its own. What happens after it is your call.
            </p>

            <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                <div class="bg-gray-50 rounded-xl p-8 border border-gray-200 flex flex-col">
                    <p class="uppercase text-xs tracking-wider font-medium text-blue-600 mb-3">Step one</p>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">SEO Audit</h3>
                    <p class="text-4xl font-extrabold text-blue-700 mb-1">$2,500</p>
                    <p class="text-sm text-gray-500 mb-6">One time. Roughly 50 pages.</p>
                    <ul class="text-gray-700 space-y-3 flex-1">
                        <li class="flex items-start"><span class="text-blue-700 mr-3">&#10003;</span><span>Technical audit, semantic keyword research and a content gap analysis</span></li>
                        <li class="flex items-start"><span class="text-blue-700 mr-3">&#10003;</span><span>Every finding written as a specific action, ordered by what it is worth</span></li>
                        <li class="flex items-start"><span class="text-blue-700 mr-3">&#10003;</span><span>Yours to keep, and yours to hand to any agency you like</span></li>
                    </ul>
                </div>

                <div class="bg-white rounded-xl p-8 border-2 border-blue-600 shadow-md flex flex-col">
                    <p class="uppercase text-xs tracking-wider font-medium text-blue-600 mb-3">Optional, step two</p>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Execution</h3>
                    <p class="text-4xl font-extrabold text-blue-700 mb-1">$997<span class="text-lg font-semibold text-gray-600"> per month</span></p>
                    <p class="text-sm text-gray-500 mb-6">Six month minimum, because three months of SEO shows you almost nothing. Cancel after that with 30 days notice.</p>
                    <ul class="text-gray-700 space-y-3 flex-1">
                        <li class="flex items-start"><span class="text-blue-700 mr-3">&#10003;</span><span>I work the audit roadmap in priority order and you see what shipped</span></li>
                        <li class="flex items-start"><span class="text-blue-700 mr-3">&#10003;</span><span>Named deliverables each month, agreed in advance, not an open bucket of hours</span></li>
                        <li class="flex items-start"><span class="text-blue-700 mr-3">&#10003;</span><span>Monthly report against the findings, so you can see what moved and what did not</span></li>
                    </ul>
                </div>
            </div>

            <div class="max-w-4xl mx-auto mt-8 bg-blue-50 border border-blue-100 rounded-xl p-6">
                <p class="text-gray-700">
                    You are not obliged to take step two. Plenty of businesses take the audit, hand it to
                    the agency they already use, and get more out of that relationship than they were before.
                    That is a fine outcome and it is why the audit is priced to stand alone.
                </p>
            </div>

            <div class="text-center mt-10">
                <a href="https://calendly.com/david-j-forer/30min" class="bg-blue-700 text-white font-bold py-4 px-10 rounded-lg shadow-lg hover:bg-blue-800 transition duration-300 inline-block">Book a 30 minute call</a>
                <p class="text-sm text-gray-600 mt-4">If search visibility is not actually what is holding you back, I will tell you that instead.</p>
            </div>
        </div>
    </section>

    {/* The Formbricks iframe embed of survey cmb8jgo1v004hoj01a5mb7gm9 was
         removed on 2026-09-18 and replaced with a native LeadForm posting to the
         same survey. The iframe was a 50vh scroll box on a third-party origin,
         it could not be styled, and it loaded a whole second app to collect 3
         fields. */}
    <FormSection
        id="contact"
        heading="Want a second opinion on your site?"
        blurb="Tell me the URL and what you are trying to move. I will tell you what is holding the site back and what I would do about it first. If search visibility is not your actual constraint, I will say that instead."
        surveyId={SEO_SURVEY}
        fields={SEO_FIELDS}
    />

    {/* FAQ. Moved below the form on 2026-09-18, David's ordering. Renders from
         the same `faqs` array that feeds the FAQPage schema. */}
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-12 text-center">Common questions</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
                {faqs.map((faq) => (
                    <div>
                        <h3 class="text-xl font-bold text-gray-800 mb-3">{faq.q}</h3>
                        <p class="text-gray-600">{faq.a}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    {/* Additional Resources Section */}
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-blue-700 mb-12 text-center">Related reading</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300">
                    <img src="/images/blog/entity-mapping.webp" alt="Entity mapping framework for modern SEO" class="rounded mb-4 w-full aspect-[16/9] object-cover" loading="lazy">
                    <h3 class="text-lg font-bold text-gray-800 mb-2">Entity Mapping: A Practical Framework for Modern SEO</h3>
                    <p class="text-gray-600 mb-4">A step-by-step guide to using entity mapping to improve search visibility by helping engines understand context, relationships, and topical authority beyond keywords.</p>
                    <a href="/blog/entity-mapping-article" class="text-blue-700 font-bold hover:underline">Read the entity mapping framework →</a>
                </div>

                <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300">
                    <img src="/images/blog/schema-markup.webp" alt="Schema markup types that affect SEO" class="rounded mb-4 w-full aspect-[16/9] object-cover" loading="lazy">
                    <h3 class="text-lg font-bold text-gray-800 mb-2">The Best Schema Markup Types for SEO</h3>
                    <p class="text-gray-600 mb-4">Which schema markup types deliver measurable SEO impact, and how to implement them without breaking the rest of your markup.</p>
                    <a href="/blog/schema-markup-seo-guide" class="text-blue-700 font-bold hover:underline">Read the schema markup guide →</a>
                </div>

                <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition duration-300">
                    <img src="/images/blog/seo-content-audit.webp" alt="Running an SEO content audit for a small business site" class="rounded mb-4 w-full aspect-[16/9] object-cover" loading="lazy">
                    <h3 class="text-lg font-bold text-gray-800 mb-2">How to Run an SEO Content Audit</h3>
                    <p class="text-gray-600 mb-4">A content audit identifies which pages are earning their place, which can be improved, which should be merged, and which are actively hurting your authority.</p>
                    <a href="/blog/seo-content-audit-small-business" class="text-blue-700 font-bold hover:underline">Read the content audit walkthrough →</a>
                </div>
