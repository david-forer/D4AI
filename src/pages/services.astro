								<h3 class="text-2xl font-bold text-gray-800 mb-4">Fixed Price</h3>
								<div class="text-5xl font-extrabold svc-num">$1,500</div>
								<p class="mt-3 text-gray-600">Delivered remotely and agreed in writing before anything starts. You can book it on its own.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		{/* SEO Accelerator Section */}
		<section class="py-16 svc svc-seo svc-a">
			<div class="container mx-auto px-6 max-w-6xl">
				<div class="flex flex-col lg:flex-row items-center gap-12">
					<div class="lg:w-1/2">
						<div class="pill">
							GROWTH
						</div>
						<h2 class="text-3xl font-bold text-gray-800 mb-6">SEO Accelerator</h2>
						<p class="text-lg text-gray-600 mb-6">
							SEO run as an operations system: technical fixes, keyword research and content, with AI doing the repetitive work. You get measurable gains in search visibility and organic traffic.
						</p>
						
