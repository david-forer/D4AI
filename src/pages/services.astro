---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbJson } from '../lib/schema';

// Service and Offer markup. Prices match the price strips on this page. If a
// price changes there, change it here.
const SITE = 'https://davidjforer.com';
const provider = { '@id': `${SITE}/#organization` };
const usd = (min: number, max?: number) => ({
  '@type': 'Offer',
  priceCurrency: 'USD',
  priceSpecification: max
    ? { '@type': 'PriceSpecification', priceCurrency: 'USD', minPrice: min, maxPrice: max }
    : { '@type': 'PriceSpecification', priceCurrency: 'USD', price: min },
});
const named = (name: string, price: number, description: string) => ({
  '@type': 'Offer', name, priceCurrency: 'USD', price, url: `${SITE}/ai-readiness-and-ai-audits`,
  description,
});
const servicesJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${SITE}/ai-readiness-and-ai-audits#service`,
      name: 'AI Readiness Audit',
      url: `${SITE}/ai-readiness-and-ai-audits`,
      provider,
      areaServed: { '@type': 'Country', name: 'United States' },
      offers: [
        named('80/20 Process Audit', 750, 'Two to three hours with the founder, delivered same day or next day.'),
        named('Quick Assessment', 1500, 'Four to six hours of interviews, one week start to finish.'),
        named('Full AI Operations Audit', 4000, 'Eight to fifteen hours of interviews over two weeks, with one working automation shipped live.'),
      ],
    },
    {
      '@type': 'Service',
      '@id': `${SITE}/ai-training-for-small-business-teams#service`,
      name: 'AI Training for Small Business Teams',
      url: `${SITE}/ai-training-for-small-business-teams`,
      provider,
      offers: { ...usd(1500), url: `${SITE}/ai-training-for-small-business-teams` },
    },
    {
      '@type': 'Service',
      '@id': `${SITE}/seo-accelerator#service`,
      name: 'SEO Accelerator',
      url: `${SITE}/seo-accelerator`,
      provider,
      offers: { ...usd(2500), name: 'SEO audit', url: `${SITE}/seo-accelerator` },
    },
    {
      '@type': 'Service',
      '@id': `${SITE}/operational-buildout#service`,
      name: 'Operational Buildout',
      url: `${SITE}/operational-buildout`,
      provider,
      offers: { ...usd(7500, 15000), url: `${SITE}/operational-buildout` },
    },
    {
      '@type': 'Service',
      '@id': `${SITE}/ai-automation-accelerator#service`,
      name: 'AI Automation Accelerator',
      url: `${SITE}/ai-automation-accelerator`,
      provider,
      offers: { ...usd(7500, 15000), url: `${SITE}/ai-automation-accelerator` },
    },
  ],
});
---

<Layout title="AI Services for Small Businesses – AI Readiness Audits and Implementation Roadmaps – SEO, Operations, and Automation Accelerators for Founder-Led Teams – David J Forer" description="AI services for founder-led small businesses: readiness audits, SEO and operations accelerators, and automation programs that cut manual work and help you scale without adding headcount.">
  <script is:inline type="application/ld+json" set:html={servicesJson} />
  <script is:inline type="application/ld+json" set:html={breadcrumbJson([['Home','/'],['Services','/services']])} />
	<div class="bg-gray-50 overflow-hidden">
		
		<PageHero
			align="center"
			title="Find the hours. Get them back."
			accent="Get them back."
			subtitle="AI operations for founder-led businesses doing $1M to $5M."
			text="An audit shows where your week goes and what it costs. Training, SEO and operations builds get the time back."
		/>

		{/* AI Audit Section */}
		<section class="py-16 svc svc-audit svc-a">
			<div class="container mx-auto px-6 max-w-6xl">
				<div class="flex flex-col lg:flex-row items-center gap-12">
					<div class="lg:w-1/2">
						<div class="pill">
							ASSESSMENT
						</div>
						<h2 class="text-3xl font-bold text-gray-800 mb-6">AI Readiness Audit</h2>
						<p class="text-lg text-gray-600 mb-6">
							Start with how your work actually runs. I map your top processes, put a dollar figure on each bottleneck, and show where AI can take the work off you. Three fixed-price audits, so you choose the depth.
						</p>
						
						<div class="space-y-4 mb-8">
							<div class="flex items-start">
								<svg class="h-6 w-6 svc-ic mr-3 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
								</svg>
								<span><strong>Your processes mapped</strong> as inputs, rules and outputs, from interviews with you and your team</span>
							</div>
							<div class="flex items-start">
								<svg class="h-6 w-6 svc-ic mr-3 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
								</svg>
								<span><strong>Opportunities priced in dollars</strong>, with the ROI math behind each</span>
							</div>
							<div class="flex items-start">
								<svg class="h-6 w-6 svc-ic mr-3 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
								</svg>
								<span><strong>A roadmap you keep</strong>, built around the tools you already pay for</span>
							</div>
						</div>

						<div class="svc-box p-6 rounded-lg mb-8">
							<h3 class="text-xl font-bold text-gray-800 mb-4">The Three Audits:</h3>
							<ul class="space-y-2 text-gray-700">
								<li>• <strong>80/20 Process Audit</strong>: 2 to 3 hours with you, delivered same day or next day</li>
								<li>• <strong>Quick Assessment</strong>: 4 to 6 hours of interviews, one week start to finish</li>
								<li>• <strong>Full AI Operations Audit</strong>: 8 to 15 hours of interviews over two weeks, with one working automation shipped live</li>
															</ul>
						</div>

						<div class="price-strip">
							<span class="price-label">Pricing</span>
							<span class="price-main">$750, $1,500 or $4,000</span>
							<span class="price-note">Fixed prices. The audit stands alone and you keep everything it produces.</span>
						</div>

						<a href="/ai-readiness-and-ai-audits" class="inline-flex items-center svc-btn text-white font-bold py-3 px-8 rounded-lg transition duration-300">
							Learn More About AI Audit
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
							</svg>
						</a>
					</div>
					
					<div class="lg:w-1/2">
						<div class="svc-result p-8 rounded-2xl">
							<div class="text-center">
								<div class="svc-ic mb-4 flex justify-center"><svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" /></svg></div>
								<h3 class="text-2xl font-bold text-gray-800 mb-2">Possible Results</h3>
								<p class="text-sm text-gray-600 mb-4 -mt-2">What an engagement can deliver. Results vary by business.</p>
								
								<div class="grid grid-cols-2 gap-6">
									<div class="text-center">
										<div class="text-3xl font-bold svc-num">10+</div>
										<div class="text-sm text-gray-600">Hours Saved Weekly</div>
									</div>
									<div class="text-center">
										<div class="text-3xl font-bold svc-num">30%</div>
										<div class="text-sm text-gray-600">Increased Capacity</div>
									</div>
									<div class="text-center">
										<div class="text-3xl font-bold svc-num">50%</div>
										<div class="text-sm text-gray-600">Faster Onboarding</div>
									</div>
									<div class="text-center">
										<div class="text-3xl font-bold svc-num">90%</div>
										<div class="text-sm text-gray-600">More Consistent</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		{/* AI Training Section. Added 2026-10-07 so this page lists the same five
		     offers as the Services menu. Facts are from /ai-training-for-small-business-teams.
