---
import Layout from "../layouts/Layout.astro";
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="404 | Page Not Found"
  description="The page you’re looking for doesn’t exist. Try the homepage or one of the helpful links."
  image="/images/social-default.webp"
>
  {/* Blue hero band (divs only), tall enough to feel intentional */}
  <PageHero
    align="center"
    eyebrow="Error 404"
    title="Wrong turn. Right consultant."
    accent="Right consultant."
    text="If your ops feel like this link, we should talk."
  />

  {/* Main content */}
  <div class="max-w-4xl mx-auto px-6 py-12">
    <div>
        {/* inside your 404.astro */}
<img
  src="/images/404.webp"
  alt="Consultant at a chaotic crossroads. Wrong turn. Right consultant."
  class="mx-auto h-auto w-full max-w-[420px] object-contain drop-shadow-xl"
  loading="lazy"
  decoding="async"
/>
</div>
    <div class="grid gap-8 md:grid-cols-2">
      
      <div>
        <h2 class="text-2xl font-semibold mb-3">Try these</h2>
        <ul class="space-y-2 text-blue-700">
          <li><a class="underline hover:no-underline" href="/">Go to the homepage</a></li>
          <li><a class="underline hover:no-underline" href="/privacy-policy">Privacy Policy</a></li>
          <li><a class="underline hover:no-underline" href="/terms-of-service">Terms of Service</a></li>
          {/* Add/adjust links you actually have */}
          {/* <li><a class="underline hover:no-underline" href="/ai-readiness-and-ai-audits">AI Audit Services</a></li> */}
          {/* <li><a class="underline hover:no-underline" href="/contact">Contact</a></li> */}
        </ul>
      </div>

      <div class="rounded-xl border border-gray-200 p-5 bg-white">
        <h3 class="text-lg font-semibold">Still stuck?</h3>
        <p class="mt-2 text-gray-700">
          Email us and we’ll point you to the right place.
        </p>
        <a
          href="mailto:david@davidjforer.com?subject=404%20help"
          class="mt-4 inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-3 font-medium text-white hover:bg-blue-700"
        >
          Email support
        </a>
      </div>
    </div>

    <div class="mt-12">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-lg border border-blue-600 px-5 py-3 font-medium text-blue-600 hover:bg-blue-50"
      >
        ← Back to Home
      </a>
    </div>
  </div>
</Layout>
